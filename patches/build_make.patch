@@ -578,6 +578,16 @@ def ModifyTargetFilesDynamicPartitionInfo(input_file, key, value):
   Returns:
     The path to modified target-files.zip
   """
+  # Plain (non-dynamic-partition) A/B builds have no dynamic partition info:
+  # nothing to modify.
+  if os.path.isdir(input_file):
+    if not os.path.exists(os.path.join(input_file, *DYNAMIC_PARTITION_INFO.split("/"))):
+      return input_file
+  else:
+    with zipfile.ZipFile(input_file, 'r', allowZip64=True) as zfp:
+      if DYNAMIC_PARTITION_INFO not in zfp.namelist():
+        return input_file
+
