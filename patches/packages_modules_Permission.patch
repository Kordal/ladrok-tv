diff --git a/PermissionController/res/drawable-television/ladrok_preference_item_background.xml b/PermissionController/res/drawable-television/ladrok_preference_item_background.xml
new file mode 100644
index 0000000..a6da529
--- /dev/null
+++ b/PermissionController/res/drawable-television/ladrok_preference_item_background.xml
@@ -0,0 +1,16 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!-- Ladrok TV: focused rows get the TvSettings pill (Line, fully rounded) instead of a
+     full-width bar. Layer insets don't add padding, so the rows keep their own. -->
+<selector xmlns:android="http://schemas.android.com/apk/res/android">
+    <item android:state_focused="true">
+        <layer-list>
+            <item android:left="8dp" android:right="8dp" android:top="2dp" android:bottom="2dp">
+                <shape android:shape="rectangle">
+                    <solid android:color="#FF262626" />
+                    <corners android:radius="999dp" />
+                </shape>
+            </item>
+        </layer-list>
+    </item>
+    <item android:drawable="@android:color/transparent" />
+</selector>
