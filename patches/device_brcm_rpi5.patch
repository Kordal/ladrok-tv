@@ -0,0 +1,40 @@
+/*
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package tv.ladrok.updater;
+
+import android.app.job.JobInfo;
+import android.app.job.JobParameters;
+import android.app.job.JobScheduler;
+import android.app.job.JobService;
+import android.content.ComponentName;
+import android.content.Context;
+
+import java.util.concurrent.TimeUnit;
+
+/** Once a day, with a network: check for an update and download it. */
+public class DailyCheckJob extends JobService {
+    private static final int JOB_ID = 1;
+
+    static void schedule(Context context) {
+        JobScheduler js = context.getSystemService(JobScheduler.class);
+        if (js.getPendingJob(JOB_ID) != null) return;
+        js.schedule(new JobInfo.Builder(JOB_ID, new ComponentName(context, DailyCheckJob.class))
+                .setPeriodic(TimeUnit.DAYS.toMillis(1))
+                .setRequiredNetworkType(JobInfo.NETWORK_TYPE_ANY)
+                .setPersisted(true)
+                .build());
+    }
+
+    @Override
+    public boolean onStartJob(JobParameters params) {
+        UpdateService.start(this, UpdateService.ACTION_CHECK);
+        return false;
+    }
+
+    @Override
+    public boolean onStopJob(JobParameters params) {
+        return false;
+    }
+}
diff --git a/LadrokUpdater/src/tv/ladrok/updater/LauncherUpdate.java b/LadrokUpdater/src/tv/ladrok/updater/LauncherUpdate.java
new file mode 100644
index 0000000..8ab4d3a
--- /dev/null
+++ b/LadrokUpdater/src/tv/ladrok/updater/LauncherUpdate.java
@@ -0,0 +1,202 @@
+/*
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package tv.ladrok.updater;
+
+import android.app.PendingIntent;
+import android.content.BroadcastReceiver;
+import android.content.Context;
+import android.content.Intent;
+import android.content.IntentFilter;
+import android.content.pm.PackageInfo;
+import android.content.pm.PackageInstaller;
+import android.content.pm.PackageManager;
+import android.content.pm.Signature;
+import android.text.TextUtils;
+import android.util.Log;
+
+import org.json.JSONArray;
+import org.json.JSONException;
+import org.json.JSONObject;
+
+import java.io.File;
+import java.io.FileInputStream;
+import java.io.IOException;
+import java.io.InputStream;
+import java.io.OutputStream;
+import java.security.MessageDigest;
+import java.security.NoSuchAlgorithmException;
+import java.util.concurrent.CountDownLatch;
+import java.util.concurrent.TimeUnit;
+
+/**
+ * Keeps Ladrok Launcher (the home screen, built into the image as a prebuilt) at its newest
+ * release between system updates. The APK is installed over the built-in one only if it is the
+ * launcher package, has a higher version code, and is signed with the pinned launcher
+ * certificate (config.xml). The package manager also refuses a key change for system apps.
+ * Runs on the update service's worker thread.
+ */
+final class LauncherUpdate {
+    private static final String TAG = Updater.TAG;
+    private static final String APK = "LadrokLauncher.apk";
+    private static final String ACTION_RESULT = "tv.ladrok.updater.LAUNCHER_INSTALLED";
+
+    private final Context mContext;
+    private final String mRepo;
+    private final String mPackage;
+    private final String mCert;
+
+    LauncherUpdate(Context context) {
+        mContext = context;
+        mRepo = context.getString(R.string.launcher_repo);
+        mPackage = context.getString(R.string.launcher_package);
+        mCert = context.getString(R.string.launcher_cert_sha256);
+    }
+
+    /** Installed launcher version name, or null if it isn't installed. */
+    static String installedVersion(Context context) {
+        try {
+            return context.getPackageManager().getPackageInfo(
+                    context.getString(R.string.launcher_package), 0).versionName;
+        } catch (PackageManager.NameNotFoundException e) {
+            return null;
+        }
+    }
+
+    /** Checks the launcher repo's latest release and installs it if it is newer. */
+    void run() throws IOException {
+        if (TextUtils.isEmpty(mRepo)) return;
+        PackageInfo installed;
+        try {
+            installed = mContext.getPackageManager().getPackageInfo(mPackage, 0);
+        } catch (PackageManager.NameNotFoundException e) {
+            return;  // only ever updated, never installed fresh
+        }
+        String tag, apkUrl = null, shaUrl = null;
+        try {
+            JSONObject release = new JSONObject(Updater.fetchString(String.format(Updater.API, mRepo)));
+            tag = release.getString("tag_name");
+            JSONArray assets = release.getJSONArray("assets");
+            for (int i = 0; i < assets.length(); i++) {
+                JSONObject a = assets.getJSONObject(i);
+                if (APK.equals(a.getString("name"))) apkUrl = a.getString("browser_download_url");
+                if ((APK + ".sha256").equals(a.getString("name"))) {
+                    shaUrl = a.getString("browser_download_url");
+                }
+            }
+        } catch (JSONException e) {
+            throw new IOException("bad launcher release data: " + e.getMessage(), e);
+        }
+        // Release tags are the version names (v0.2.0); the same name means nothing to do
+        if (tag.equals(installed.versionName)) return;
+        if (apkUrl == null || shaUrl == null) throw new IOException("launcher " + tag + " has no " + APK);
+
+        File f = new File(mContext.getCacheDir(), APK);
+        try {
+            Updater.downloadTo(apkUrl, f);
+            String want = Updater.fetchString(shaUrl).trim().split("\\s+")[0];
+            if (!want.equalsIgnoreCase(sha256(f))) {
+                throw new IOException("launcher " + tag + " download is corrupt (SHA-256 mismatch)");
+            }
+            PackageInfo apk = mContext.getPackageManager().getPackageArchiveInfo(f.getPath(),
+                    PackageManager.GET_SIGNING_CERTIFICATES);
+            if (apk == null || !mPackage.equals(apk.packageName)) {
+                throw new IOException("launcher " + tag + " is not " + mPackage);
+            }
+            if (!signedWithPinnedKey(apk)) {
+                throw new IOException("launcher " + tag + " is not signed with the launcher key");
+            }
+            if (apk.getLongVersionCode() <= installed.getLongVersionCode()) {
+                Log.i(TAG, "launcher " + tag + " is not newer than " + installed.versionName);
+                return;
+            }
+            install(f);
+            Log.i(TAG, "launcher updated " + installed.versionName + " -> " + apk.versionName);
+        } finally {
+            f.delete();
+        }
+    }
+
+    private boolean signedWithPinnedKey(PackageInfo apk) throws IOException {
+        if (apk.signingInfo == null || apk.signingInfo.hasMultipleSigners()) return false;
+        Signature[] signers = apk.signingInfo.getApkContentsSigners();
+        if (signers == null || signers.length != 1) return false;
+        return mCert.equalsIgnoreCase(hex(digest(signers[0].toByteArray())));
+    }
+
+    /** Installs without asking: this app runs as the system UID, which holds INSTALL_PACKAGES. */
+    private void install(File apk) throws IOException {
+        PackageInstaller pi = mContext.getPackageManager().getPackageInstaller();
+        PackageInstaller.SessionParams params =
+                new PackageInstaller.SessionParams(PackageInstaller.SessionParams.MODE_FULL_INSTALL);
+        params.setAppPackageName(mPackage);
+        params.setRequireUserAction(PackageInstaller.SessionParams.USER_ACTION_NOT_REQUIRED);
+        int id = pi.createSession(params);
+
+        CountDownLatch done = new CountDownLatch(1);
+        int[] status = {PackageInstaller.STATUS_FAILURE};
+        String[] message = {null};
+        BroadcastReceiver receiver = new BroadcastReceiver() {
+            @Override
+            public void onReceive(Context context, Intent intent) {
+                status[0] = intent.getIntExtra(PackageInstaller.EXTRA_STATUS,
+                        PackageInstaller.STATUS_FAILURE);
+                message[0] = intent.getStringExtra(PackageInstaller.EXTRA_STATUS_MESSAGE);
+                done.countDown();
+            }
+        };
+        mContext.registerReceiver(receiver, new IntentFilter(ACTION_RESULT),
+                Context.RECEIVER_NOT_EXPORTED);
+        try (PackageInstaller.Session session = pi.openSession(id)) {
+            try (InputStream in = new FileInputStream(apk);
+                 OutputStream out = session.openWrite("base.apk", 0, apk.length())) {
+                byte[] buf = new byte[1 << 16];
+                int n;
+                while ((n = in.read(buf)) > 0) out.write(buf, 0, n);
+                session.fsync(out);
+            }
+            PendingIntent result = PendingIntent.getBroadcast(mContext, id,
+                    new Intent(ACTION_RESULT).setPackage(mContext.getPackageName()),
+                    PendingIntent.FLAG_MUTABLE);
+            session.commit(result.getIntentSender());
+            if (!done.await(5, TimeUnit.MINUTES)) throw new IOException("launcher install timed out");
+        } catch (InterruptedException e) {
+            Thread.currentThread().interrupt();
+            throw new IOException("launcher install interrupted");
+        } finally {
+            mContext.unregisterReceiver(receiver);
+        }
+        if (status[0] != PackageInstaller.STATUS_SUCCESS) {
+            throw new IOException("launcher install failed: " + message[0]);
+        }
+    }
+
+    private static String sha256(File f) throws IOException {
+        try (InputStream in = new FileInputStream(f)) {
+            MessageDigest md = sha256Digest();
+            byte[] buf = new byte[1 << 16];
+            int n;
+            while ((n = in.read(buf)) > 0) md.update(buf, 0, n);
+            return hex(md.digest());
+        }
+    }
+
+    private static byte[] digest(byte[] data) throws IOException {
+        return sha256Digest().digest(data);
+    }
+
+    private static MessageDigest sha256Digest() throws IOException {
+        try {
+            return MessageDigest.getInstance("SHA-256");
+        } catch (NoSuchAlgorithmException e) {
+            throw new IOException(e);
+        }
+    }
+
+    private static String hex(byte[] bytes) {
+        StringBuilder sb = new StringBuilder();
+        for (byte b : bytes) sb.append(String.format("%02x", b));
+        return sb.toString();
+    }
+}
diff --git a/LadrokUpdater/src/tv/ladrok/updater/UpdateActivity.java b/LadrokUpdater/src/tv/ladrok/updater/UpdateActivity.java
new file mode 100644
index 0000000..2e7bf13
--- /dev/null
+++ b/LadrokUpdater/src/tv/ladrok/updater/UpdateActivity.java
@@ -0,0 +1,174 @@
+/*
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package tv.ladrok.updater;
+
+import android.os.Build;
+import android.os.Bundle;
+import android.os.Handler;
+import android.os.Looper;
+import android.text.format.DateFormat;
+import android.text.format.Formatter;
+
+import androidx.annotation.NonNull;
+import androidx.fragment.app.FragmentActivity;
+import androidx.leanback.app.GuidedStepSupportFragment;
+import androidx.leanback.widget.GuidanceStylist.Guidance;
+import androidx.leanback.widget.GuidedAction;
+
+import java.util.ArrayList;
+import java.util.List;
+
+/** Shows the update state and offers the next step (check, install, restart). */
+public class UpdateActivity extends FragmentActivity {
+    @Override
+    protected void onCreate(Bundle savedInstanceState) {
+        super.onCreate(null);
+        GuidedStepSupportFragment.addAsRoot(this, new UpdateFragment(), android.R.id.content);
+    }
+
+    public static class UpdateFragment extends GuidedStepSupportFragment {
+        private static final long ACTION_CHECK = 1;
+        private static final long ACTION_INSTALL = 2;
+        private static final long ACTION_REBOOT = 3;
+        private static final long ACTION_LATER = 4;
+
+        private final Handler mHandler = new Handler(Looper.getMainLooper());
+        private final Runnable mRefresh = new Runnable() {
+            @Override
+            public void run() {
+                refresh();
+                mHandler.postDelayed(this, 1000);
+            }
+        };
+        private String mShown;
+
+        @Override
+        @NonNull
+        public Guidance onCreateGuidance(Bundle savedInstanceState) {
+            return new Guidance(getString(R.string.app_name), describe(), null,
+                    requireContext().getDrawable(R.drawable.ic_launcher));
+        }
+
+        @Override
+        public void onCreateActions(@NonNull List<GuidedAction> actions, Bundle savedInstanceState) {
+            actions.addAll(actionsFor(Updater.get(requireContext()).state()));
+        }
+
+        @Override
+        public void onResume() {
+            super.onResume();
+            mHandler.post(mRefresh);
+        }
+
+        @Override
+        public void onPause() {
+            mHandler.removeCallbacks(mRefresh);
+            super.onPause();
+        }
+
+        @Override
+        public void onGuidedActionClicked(GuidedAction action) {
+            long id = action.getId();
+            if (id == ACTION_CHECK) {
+                UpdateService.start(requireContext(), UpdateService.ACTION_CHECK);
+            } else if (id == ACTION_INSTALL) {
+                UpdateService.start(requireContext(), UpdateService.ACTION_INSTALL);
+            } else if (id == ACTION_REBOOT) {
+                UpdateService.start(requireContext(), UpdateService.ACTION_REBOOT);
+            } else {
+                requireActivity().finish();
+            }
+        }
+
+        private void refresh() {
+            Updater u = Updater.get(requireContext());
+            String text = describe();
+            String key = u.state() + "|" + text;
+            if (key.equals(mShown)) return;
+            boolean stateChanged = mShown == null || !mShown.startsWith(u.state() + "|");
+            mShown = key;
+            if (getGuidanceStylist().getDescriptionView() != null) {
+                getGuidanceStylist().getDescriptionView().setText(text);
+            }
+            if (stateChanged) {
+                setActions(actionsFor(u.state()));
+                // Keep the D-pad on the main action (setActions would leave it on "Later").
+                setSelectedActionPosition(0);
+            }
+        }
+
+        private List<GuidedAction> actionsFor(Updater.State state) {
+            List<GuidedAction> list = new ArrayList<>();
+            switch (state) {
+                case READY:
+                    list.add(action(ACTION_INSTALL, R.string.action_install,
+                            getString(R.string.action_install_desc)));
+                    break;
+                case NEED_REBOOT:
+                    list.add(action(ACTION_REBOOT, R.string.action_reboot, null));
+                    break;
+                case CHECKING:
+                case DOWNLOADING:
+                case INSTALLING:
+                    break;
+                default:
+                    list.add(action(ACTION_CHECK, R.string.action_check, null));
+                    break;
+            }
+            list.add(action(ACTION_LATER, R.string.action_later, null));
+            return list;
+        }
+
+        private GuidedAction action(long id, int title, String description) {
+            return new GuidedAction.Builder(requireContext())
+                    .id(id)
+                    .title(getString(title))
+                    .description(description)
+                    .build();
+        }
+
+        private String describe() {
+            Updater u = Updater.get(requireContext());
+            UpdateConfig c = u.config();
+            String v = c != null ? c.version : "";
+            String current = getString(R.string.current_version, Build.VERSION.INCREMENTAL,
+                    DateFormat.getMediumDateFormat(requireContext()).format(Build.TIME));
+            String launcher = LauncherUpdate.installedVersion(requireContext());
+            if (launcher != null) current += "\n" + getString(R.string.launcher_version, launcher);
+            String state;
+            switch (u.state()) {
+                case CHECKING:
+                    state = getString(R.string.state_checking);
+                    break;
+                case UP_TO_DATE:
+                    state = getString(R.string.state_up_to_date);
+                    break;
+                case DOWNLOADING:
+                    state = getString(R.string.state_downloading, v, u.progress());
+                    break;
+                case READY:
+                    state = getString(R.string.state_ready, v) + "\n"
+                            + Formatter.formatShortFileSize(requireContext(), c != null ? c.size : 0);
+                    break;
+                case INSTALLING:
+                    state = getString(R.string.state_installing, v, u.progress());
+                    break;
+                case NEED_REBOOT:
+                    state = getString(R.string.state_need_reboot, v);
+                    break;
+                case UPDATED:
+                    state = getString(R.string.state_updated, v);
+                    break;
+                case ERROR:
+                    state = getString(R.string.state_error, u.error());
+                    break;
+                default:
+                    state = getString(R.string.state_idle);
+                    break;
+            }
+            return current + "\n\n" + state;
+        }
+    }
+}
diff --git a/LadrokUpdater/src/tv/ladrok/updater/UpdateConfig.java b/LadrokUpdater/src/tv/ladrok/updater/UpdateConfig.java
