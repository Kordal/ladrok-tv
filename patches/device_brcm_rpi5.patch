+# them there): bluetooth_prop, default_prop, device_config_mglru_native_prop.
+PRODUCT_PRODUCT_PROPERTIES += \
+    persist.bluetooth.a2dp_aac.vbr_supported=true \
+    ro.lockscreen.disable.default=true \
+    persist.device_config.mglru_native.lru_gen_config=core
+
+# A/B updates: boot control through the Pi firmware's autoboot.txt + tryboot
+PRODUCT_PACKAGES += \
+    android.hardware.boot-service.rpi \
+    rpi_tryboot \
+    update_engine \
+    update_engine_client \
+    update_verifier
+
+# OTA payloads must be signed with this key's private half (kept outside the source tree,
+# see scripts/make-ota.sh); update_engine refuses anything else. otacerts_ladrok replaces the
+# stock otacerts.zip, which would also trust the public AOSP test key.
+PRODUCT_OTA_PUBLIC_KEYS := $(DEVICE_PATH)/security/ota.x509.pem
+PRODUCT_PACKAGES += \
+    otacerts_ladrok
