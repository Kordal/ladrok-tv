@@ -0,0 +1,10 @@
+cc_binary {
+    name: "rpi_resize_data",
+    vendor: true,
+    srcs: ["rpi_resize_data.c"],
+    init_rc: ["rpi_resize_data.rc"],
+    cflags: [
+        "-Wall",
+        "-Werror",
