+/*
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package tv.ladrok.setup;
+
+import android.icu.util.ULocale;
+import android.os.Bundle;
+import android.view.View;
+
+import androidx.leanback.app.GuidedStepSupportFragment;
+import androidx.leanback.widget.GuidedAction;
+
+import java.util.Locale;
+
+/** A setup step showing one list of choices; the action id is the index into that list. */
+public abstract class BaseStep extends GuidedStepSupportFragment {
+    /** Position the D-pad cursor starts on. */
+    int mInitialSelection = 0;
+
+    SetupActivity setup() {
+        return (SetupActivity) requireActivity();
+    }
+
+    GuidedAction choice(int index, CharSequence title, CharSequence description) {
+        return new GuidedAction.Builder(requireContext())
+                .id(index)
+                .title(title)
+                .description(description)
+                .build();
+    }
+
+    void next(GuidedStepSupportFragment step) {
+        add(getParentFragmentManager(), step);
+    }
+
+    @Override
+    public void onViewCreated(View view, Bundle savedInstanceState) {
+        super.onViewCreated(view, savedInstanceState);
+        if (mInitialSelection > 0) {
+            setSelectedActionPosition(mInitialSelection);
+        }
+    }
+
+    /** The most likely country for a locale without one, e.g. "fr" -> "FR". */
+    static String likelyCountry(Locale locale) {
+        if (!locale.getCountry().isEmpty()) {
+            return locale.getCountry();
+        }
+        return ULocale.addLikelySubtags(ULocale.forLocale(locale)).getCountry();
+    }
+}
diff --git a/LadrokSetup/src/tv/ladrok/setup/ConfirmStep.java b/LadrokSetup/src/tv/ladrok/setup/ConfirmStep.java
