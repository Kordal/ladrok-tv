diff --git a/LadrokRemoteHelper/Android.bp b/LadrokRemoteHelper/Android.bp
new file mode 100644
index 0000000..19b3acc
--- /dev/null
+++ b/LadrokRemoteHelper/Android.bp
@@ -0,0 +1,39 @@
+//
+// SPDX-License-Identifier: Apache-2.0
+//
+// Lets a phone running Ladrok Remote (github.com/Kordal/ladrok-remote) be the TV's Bluetooth
+// remote. The Remote is a Bluetooth HID keyboard, and the TV's HID host only accepts incoming
+// HID connections from devices it has connected to itself. TV Settings has no Connect action,
+// so when a newly paired device offers HID, this makes that first connection.
+
+prebuilt_etc {
+    name: "default_permissions_tv.ladrok.remotehelper",
+    system_ext_specific: true,
+    sub_dir: "default-permissions",
+    src: "default-permissions-tv.ladrok.remotehelper.xml",
+    filename_from_src: true,
+}
+
+prebuilt_etc {
+    name: "privapp_whitelist_tv.ladrok.remotehelper",
+    system_ext_specific: true,
+    sub_dir: "permissions",
+    src: "tv.ladrok.remotehelper.xml",
+    filename_from_src: true,
+}
+
+android_app {
+    name: "LadrokRemoteHelper",
+    srcs: ["src/**/*.java"],
+    platform_apis: true,
+    system_ext_specific: true,
+    certificate: "platform",
+    privileged: true,
+    required: [
+        "default_permissions_tv.ladrok.remotehelper",
+        "privapp_whitelist_tv.ladrok.remotehelper",
+    ],
+    optimize: {
+        enabled: false,
+    },
+}
diff --git a/LadrokRemoteHelper/AndroidManifest.xml b/LadrokRemoteHelper/AndroidManifest.xml
new file mode 100644
index 0000000..1e28a90
--- /dev/null
+++ b/LadrokRemoteHelper/AndroidManifest.xml
@@ -0,0 +1,17 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!-- SPDX-License-Identifier: Apache-2.0 -->
+<!-- No UI. Persistent, because Bluetooth sends ACTION_BOND_STATE_CHANGED and ACTION_UUID without
+     FLAG_RECEIVER_INCLUDE_BACKGROUND, so a manifest receiver would never get them: the
+     receiver is registered by RemoteHelperApp in the always-running process instead. -->
+<manifest xmlns:android="http://schemas.android.com/apk/res/android"
+        package="tv.ladrok.remotehelper">
+
+    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
+    <uses-permission android:name="android.permission.BLUETOOTH_PRIVILEGED" />
+
+    <application
+            android:name=".RemoteHelperApp"
+            android:label="Ladrok Remote helper"
+            android:persistent="true"
+            android:allowBackup="false" />
+</manifest>
