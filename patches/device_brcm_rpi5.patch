diff --git a/BoardConfig.mk b/BoardConfig.mk
index 89cbc00..b4be365 100644
--- a/BoardConfig.mk
+++ b/BoardConfig.mk
@@ -26,6 +26,23 @@ TARGET_SCREEN_DENSITY := 240
 BOARD_CUSTOM_BOOTIMG := true
 BOARD_CUSTOM_BOOTIMG_MK := $(DEVICE_PATH)/mkbootimg.mk
 BOARD_KERNEL_CMDLINE := console=ttyAMA10,115200 androidboot.hardware=rpi5 androidboot.verifiedbootstate=orange
+# SD card controller: init creates /dev/block/by-name/* (GPT names) for partitions on it
+BOARD_KERNEL_CMDLINE += androidboot.boot_devices=soc@107c000000/1000fff000.mmc
+# Reboot on panic, so a broken slot falls back to the other one (tryboot is one-shot)
+BOARD_KERNEL_CMDLINE += panic=10
+# ro.boot.* properties can only come from the bootloader/cmdline, not from vendor.prop
+BOARD_KERNEL_CMDLINE += androidboot.audio.tinyalsa.simulate_input=true
+
+# A/B updates (update_engine). The Pi firmware boots the FAT "rpiboot" partition of a slot;
+# it is not an Android boot image, so it is not called "boot". mkbootimg.mk builds
+# rpiboot.img and adds it to the target files as a radio image.
+AB_OTA_UPDATER := true
+AB_OTA_PARTITIONS := rpiboot system vendor
+BOARD_PACK_RADIOIMAGES := rpiboot.img
+
+# Platform (system_ext) SELinux rules: they refer to platform-private types such as
+# audioserver_tmpfs, which vendor sepolicy/ cannot use.
+SYSTEM_EXT_PRIVATE_SEPOLICY_DIRS += $(DEVICE_PATH)/sepolicy_system_ext
 
 # Manifest
 DEVICE_FRAMEWORK_COMPATIBILITY_MATRIX_FILE := $(DEVICE_PATH)/framework_compatibility_matrix.xml
@@ -37,9 +54,9 @@ BOARD_FLASH_BLOCK_SIZE := 4096
 BOARD_USES_METADATA_PARTITION := true
 BOARD_BOOTIMAGE_PARTITION_SIZE := 134217728 # 128M
 BOARD_METADATAIMAGE_PARTITION_SIZE := 16777216 # 16M
-BOARD_SYSTEMIMAGE_PARTITION_SIZE := 3221225472 # 3072M
+BOARD_SYSTEMIMAGE_PARTITION_SIZE := 6442450944 # 6144M (layout 2; keep in sync with scripts/mkimg-ab.sh)
 BOARD_USERDATAIMAGE_PARTITION_SIZE := 134217728 # 128M
-BOARD_VENDORIMAGE_PARTITION_SIZE := 402653184 # 384M
+BOARD_VENDORIMAGE_PARTITION_SIZE := 1073741824 # 1024M (layout 2)
 BOARD_VENDORIMAGE_FILE_SYSTEM_TYPE := ext4
 TARGET_USERIMAGES_SPARSE_EXT_DISABLED := true
 TARGET_USERIMAGES_USE_EXT4 := true
@@ -56,7 +73,7 @@ TARGET_NO_RECOVERY := true
 
 # SELinux
 BOARD_SEPOLICY_DIRS += device/brcm/rpi5/sepolicy
-BOARD_KERNEL_CMDLINE += androidboot.selinux=permissive
