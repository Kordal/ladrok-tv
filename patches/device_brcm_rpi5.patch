diff --git a/resize_data/rpi_resize_data.c b/resize_data/rpi_resize_data.c
new file mode 100644
index 0000000..a7103a4
--- /dev/null
+++ b/resize_data/rpi_resize_data.c
@@ -0,0 +1,306 @@
+/*
+ * Grow the userdata partition (the last GPT partition, or last MBR primary partition) to
+ * the end of the SD card, then grow its ext4 filesystem online. Runs on every boot after /data is mounted;
+ * a no-op once the partition already fills the card.
+ *
+ * Usage: rpi_resize_data [disk partition partno]
+ *   default: the disk and partition /data is mounted from (SD card or USB boot)
+ */
+#include <errno.h>
+#include <fcntl.h>
+#include <libgen.h>
+#include <limits.h>
+#include <linux/blkpg.h>
+#include <linux/fs.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/ioctl.h>
+#include <sys/vfs.h>
+#include <unistd.h>
+
+#define SECTOR 512
+/* Not in the uapi headers (fs/ext4/ext4.h): online resize, argument = new block count */
+#define EXT4_IOC_RESIZE_FS _IOW('f', 16, uint64_t)
+/* Any directory on /data will do; vendor services may use this one. */
+#define DATA_DIR "/data/vendor"
+#define ALIGN 2048 /* sectors, 1 MiB */
+
+static char disk_buf[PATH_MAX], part_buf[PATH_MAX];
+
+/* Find the block device mounted on /data and its parent disk via sysfs. */
+static int find_data_device(const char** disk, const char** part, int* pno) {
+    char dev[PATH_MAX], mnt[PATH_MAX], path[PATH_MAX], real[PATH_MAX];
+    FILE* f = fopen("/proc/mounts", "re");
+    int found = 0;
+    while (f && fscanf(f, "%4095s %4095s %*[^\n]", dev, mnt) == 2) {
+        if (!strcmp(mnt, "/data")) {
+            found = 1;
+            break;
+        }
+    }
+    if (f) fclose(f);
+    if (!found || !realpath(dev, real)) return -1;
+    snprintf(part_buf, sizeof(part_buf), "%s", real);
+    const char* name = basename(real);
+
+    snprintf(path, sizeof(path), "/sys/class/block/%s/partition", name);
+    f = fopen(path, "re");
+    if (!f || fscanf(f, "%d", pno) != 1) {
+        if (f) fclose(f);
+        return -1;
+    }
+    fclose(f);
+
+    snprintf(path, sizeof(path), "/sys/class/block/%s/..", name);
+    if (!realpath(path, real)) return -1;
+    snprintf(disk_buf, sizeof(disk_buf), "/dev/block/%s", basename(real));
+    *disk = disk_buf;
+    *part = part_buf;
+    return 0;
+}
+
+static uint32_t rd32(const uint8_t* p) {
+    return p[0] | p[1] << 8 | p[2] << 16 | (uint32_t)p[3] << 24;
+}
+
+static void wr32(uint8_t* p, uint32_t v) {
+    p[0] = v;
+    p[1] = v >> 8;
+    p[2] = v >> 16;
+    p[3] = v >> 24;
+}
+
+static uint64_t rd64(const uint8_t* p) {
+    return rd32(p) | (uint64_t)rd32(p + 4) << 32;
+}
+
+static void wr64(uint8_t* p, uint64_t v) {
+    wr32(p, (uint32_t)v);
+    wr32(p + 4, (uint32_t)(v >> 32));
+}
+
+/* CRC-32 (IEEE 802.3), as used by GPT. */
+static uint32_t crc32(const uint8_t* p, size_t n) {
+    uint32_t c = 0xffffffff;
+    while (n--) {
+        c ^= *p++;
+        for (int k = 0; k < 8; k++) c = c >> 1 ^ (0xedb88320 & -(c & 1));
+    }
+    return ~c;
+}
+
+static int write_at(int fd, const void* buf, size_t n, uint64_t lba) {
+    return pwrite(fd, buf, n, (off_t)(lba * SECTOR)) == (ssize_t)n ? 0 : -1;
+}
+
+/*
+ * GPT: grow partition `pno` (must end last) to the end of the disk, moving the backup
+ * header and entries to the real end of the disk (an image written to a bigger card has
+ * them in the middle). Returns 1 if grown (start and size get the new extent), 0 if nothing to do,
+ * -1 on error.
+ */
+static int grow_gpt(int fd, uint64_t disk_sectors, int pno, uint64_t* start, uint64_t* size) {
+    uint8_t hdr[SECTOR];
+    if (pread(fd, hdr, SECTOR, SECTOR) != SECTOR || memcmp(hdr, "EFI PART", 8)) {
+        printf("rpi_resize_data: no valid GPT header\n");
+        return -1;
+    }
+    uint32_t hdr_size = rd32(hdr + 12), n_entries = rd32(hdr + 80), entry_size = rd32(hdr + 84);
+    uint64_t entries_lba = rd64(hdr + 72);
+    if (hdr_size < 92 || hdr_size > SECTOR || entry_size < 128 || pno < 1 ||
+        (uint32_t)pno > n_entries) {
+        printf("rpi_resize_data: unexpected GPT header\n");
+        return -1;
+    }
+    size_t table_bytes = (size_t)n_entries * entry_size;
+    uint64_t table_sectors = (table_bytes + SECTOR - 1) / SECTOR;
+    uint8_t* table = calloc(1, table_sectors * SECTOR);
+    if (!table || pread(fd, table, table_bytes, (off_t)(entries_lba * SECTOR)) != (ssize_t)table_bytes ||
+        crc32(table, table_bytes) != rd32(hdr + 88)) {
+        printf("rpi_resize_data: cannot read the GPT entries (or bad CRC)\n");
+        free(table);
+        return -1;
+    }
+
+    uint8_t* e = table + (size_t)(pno - 1) * entry_size;
+    uint64_t first = rd64(e + 32), last = rd64(e + 40);
+    for (uint32_t i = 0; i < n_entries; i++) {
+        if (rd64(table + (size_t)i * entry_size + 40) > last) {
+            printf("rpi_resize_data: partition %d is not the last one on disk, leaving it alone\n", pno);
+            free(table);
+            return -1;
+        }
+    }
+
+    uint64_t backup_lba = disk_sectors - 1;
+    uint64_t backup_entries_lba = backup_lba - table_sectors;
+    uint64_t last_usable = backup_entries_lba - 1;
+    uint64_t new_last = first + (last_usable + 1 - first) / ALIGN * ALIGN - 1;
+    *start = first;
+    *size = last - first + 1;
+    if (new_last <= last + ALIGN) {
+        free(table);
+        return 0;
+    }
+    printf("rpi_resize_data: growing GPT partition %d from %llu to %llu sectors\n", pno,
+           (unsigned long long)*size, (unsigned long long)(new_last - first + 1));
+    wr64(e + 40, new_last);
+    uint32_t table_crc = crc32(table, table_bytes);
+
+    /* Primary header: same place, new backup location and usable range. */
+    wr64(hdr + 32, backup_lba);
+    wr64(hdr + 48, last_usable);
+    wr32(hdr + 88, table_crc);
+    wr32(hdr + 16, 0);
+    wr32(hdr + 16, crc32(hdr, hdr_size));
+
+    /* Backup header: mirror of the primary, pointing at the backup entries. */
+    uint8_t bak[SECTOR];
+    memcpy(bak, hdr, SECTOR);
+    wr64(bak + 24, backup_lba);
+    wr64(bak + 32, 1);
+    wr64(bak + 72, backup_entries_lba);
+    wr32(bak + 16, 0);
+    wr32(bak + 16, crc32(bak, hdr_size));
+
+    /* Backup copy first, so a valid table exists at every step. */
+    int r = write_at(fd, table, table_sectors * SECTOR, backup_entries_lba) ||
+            write_at(fd, bak, SECTOR, backup_lba) || fsync(fd) ||
+            write_at(fd, table, table_sectors * SECTOR, entries_lba) ||
+            write_at(fd, hdr, SECTOR, 1) || fsync(fd);
+    free(table);
+    if (r) {
+        printf("rpi_resize_data: writing GPT failed: %s\n", strerror(errno));
+        return -1;
+    }
+    *size = new_last - first + 1;
+    return 1;
+}
+
+/* Tell the kernel about the new size without re-reading the whole table
+ * (that fails while other partitions on the card are mounted). */
+static void apply_size(int fd, int pno, uint64_t start, uint64_t size) {
+    struct blkpg_partition bp = {
+            .start = (long long)(start * SECTOR),
+            .length = (long long)(size * SECTOR),
+            .pno = pno,
+    };
+    struct blkpg_ioctl_arg arg = {
+            .op = BLKPG_RESIZE_PARTITION,
+            .datalen = sizeof(bp),
+            .data = &bp,
+    };
+    if (ioctl(fd, BLKPG, &arg)) {
+        printf("rpi_resize_data: BLKPG failed (%s); new size applies after reboot\n",
+               strerror(errno));
+        exit(0);
+    }
+}
+
+/*
+ * Grow the mounted ext4 on /data to fill `sectors`, like resize2fs does online, through any
+ * directory on that filesystem. (A vendor service may not exec /system/bin/resize2fs.)
+ * The kernel treats an unchanged size as a no-op.
+ */
+static int grow_fs(uint64_t sectors) {
+    struct statfs st;
+    int dfd = open(DATA_DIR, O_RDONLY | O_DIRECTORY | O_CLOEXEC);
+    if (dfd < 0 || fstatfs(dfd, &st)) {
+        printf("rpi_resize_data: cannot open %s: %s\n", DATA_DIR, strerror(errno));
+        return 1;
+    }
+    uint64_t blocks = sectors * SECTOR / (uint64_t)st.f_bsize;
+    int r = ioctl(dfd, EXT4_IOC_RESIZE_FS, &blocks);
+    int err = errno;
+    close(dfd);
+    if (r) {
+        printf("rpi_resize_data: online resize to %llu blocks failed: %s\n",
+               (unsigned long long)blocks, strerror(err));
+        return 1;
+    }
+    printf("rpi_resize_data: filesystem spans %llu blocks of %ld bytes\n",
+           (unsigned long long)blocks, (long)st.f_bsize);
+    return 0;
+}
+
+int main(int argc, char** argv) {
+    const char* disk;
+    const char* part;
+    int pno;
+    uint8_t mbr[SECTOR];
+    uint64_t bytes;
+
+    /* stdout goes to kmsg (not a tty): line-buffer it so every message gets out */
+    setvbuf(stdout, NULL, _IOLBF, 0);
+    if (argc > 3) {
+        disk = argv[1];
+        part = argv[2];
+        pno = atoi(argv[3]);
+    } else if (find_data_device(&disk, &part, &pno)) {
+        printf("rpi_resize_data: cannot find the block device of /data\n");
+        return 1;
+    }
+    printf("rpi_resize_data: %s partition %d on %s\n", part, pno, disk);
+    int fd = open(disk, O_RDWR | O_CLOEXEC);
+    if (fd < 0 || ioctl(fd, BLKGETSIZE64, &bytes) || pread(fd, mbr, SECTOR, 0) != SECTOR) {
+        printf("rpi_resize_data: cannot read %s: %s\n", disk, strerror(errno));
+        return 1;
+    }
+    if (mbr[510] != 0x55 || mbr[511] != 0xaa) {
+        printf("rpi_resize_data: %s has no MBR, leaving it alone\n", disk);
+        return 1;
+    }
+
+    if (mbr[446 + 4] == 0xee) { /* protective MBR: the real table is GPT */
+        uint64_t start, size;
+        int r = grow_gpt(fd, bytes / SECTOR, pno, &start, &size);
+        if (r < 0) return 1;
+        if (r > 0) {
+            /* Protective MBR entry covers the whole disk (capped at 2 TiB). */
+            uint64_t pmbr = bytes / SECTOR - 1;
+            wr32(mbr + 446 + 12, pmbr > UINT32_MAX ? UINT32_MAX : (uint32_t)pmbr);
+            if (pwrite(fd, mbr, SECTOR, 0) != SECTOR || fsync(fd)) {
+                printf("rpi_resize_data: writing protective MBR failed: %s\n", strerror(errno));
+            }
+            apply_size(fd, pno, start, size);
+        }
+        close(fd);
+        return grow_fs(size);
+    }
+
+    if (pno < 1 || pno > 4) {
+        printf("rpi_resize_data: partno must be a primary partition (1-4)\n");
+        return 1;
+    }
+    uint8_t* e = mbr + 446 + 16 * (pno - 1);
+    uint64_t start = rd32(e + 8), size = rd32(e + 12), disk_sectors = bytes / SECTOR;
+    if (e[4] != 0x83 || size == 0) {
+        printf("rpi_resize_data: partition %d is not a Linux partition, leaving it alone\n", pno);
+        return 1;
+    }
+    for (int i = 0; i < 4; i++) {
+        const uint8_t* o = mbr + 446 + 16 * i;
+        if (rd32(o + 12) && rd32(o + 8) + (uint64_t)rd32(o + 12) > start + size) {
+            printf("rpi_resize_data: partition %d is not the last one on disk, leaving it alone\n", pno);
+            return 1;
+        }
+    }
+
+    uint64_t target = (disk_sectors - start) / ALIGN * ALIGN;
+    if (target > UINT32_MAX) target = UINT32_MAX / ALIGN * ALIGN;
+    if (target > size + ALIGN) {
+        printf("rpi_resize_data: growing partition %d from %llu to %llu sectors\n", pno,
+               (unsigned long long)size, (unsigned long long)target);
+        wr32(e + 12, (uint32_t)target);
+        if (pwrite(fd, mbr, SECTOR, 0) != SECTOR || fsync(fd)) {
+            printf("rpi_resize_data: writing MBR failed: %s\n", strerror(errno));
+            return 1;
+        }
+        apply_size(fd, pno, start, target);
+        size = target;
+    }
+    close(fd);
+    return grow_fs(size);
+}
diff --git a/resize_data/rpi_resize_data.rc b/resize_data/rpi_resize_data.rc
new file mode 100644
index 0000000..840867c
--- /dev/null
+++ b/resize_data/rpi_resize_data.rc
@@ -0,0 +1,11 @@
+# Disk, userdata partition and its GPT entry number are fixed by the A/B layout
+# (scripts/mkimg-ab.sh), so no sysfs lookups are needed.
+service rpi_resize_data /vendor/bin/rpi_resize_data /dev/block/mmcblk0 /dev/block/by-name/userdata 10
+    user root
+    group root
+    disabled
+    oneshot
+    stdio_to_kmsg
+
+on post-fs-data
+    start rpi_resize_data
diff --git a/security/Android.bp b/security/Android.bp
new file mode 100644
index 0000000..5f2e082
--- /dev/null
+++ b/security/Android.bp
@@ -0,0 +1,25 @@
+//
+// SPDX-License-Identifier: Apache-2.0
+//
+// update_engine accepts OTA payloads signed by any certificate in
+// /system/etc/security/otacerts.zip. The stock otacerts module always includes the platform
+// certificate, which on this build is the public AOSP test key, and update_engine requires
+// that module. So we ship a zip with only our OTA certificate on vendor and init.rpi5.rc
+// bind-mounts it over the stock one before update_engine starts. The private key stays
+// outside the source tree (see scripts/make-ota.sh).
+
+genrule {
+    name: "ladrok_otacerts_zip",
+    srcs: ["ota.x509.pem"],
+    tools: ["soong_zip"],
+    cmd: "$(location soong_zip) -o $(out) -j -f $(in)",
+    out: ["otacerts_ladrok.zip"],
+}
+
+prebuilt_etc {
+    name: "otacerts_ladrok",
+    vendor: true,
+    src: ":ladrok_otacerts_zip",
+    sub_dir: "security",
+    filename: "otacerts_ladrok.zip",
+}
