new file mode 100644
index 0000000..0642a31
--- /dev/null
+++ b/sepolicy/hal_bootctl_default.te
@@ -0,0 +1,14 @@
+# Boot control HAL (android.hardware.boot-service.rpi): slot switching through the Pi
+# firmware. See device/brcm/rpi5/boot_control.
+
+# Tryboot flag: VideoCore mailbox property call (IOCTL_MBOX_PROPERTY = _IOWR(100, 0, char *))
+allow hal_bootctl_default vcio_device:chr_file rw_file_perms;
+allowxperm hal_bootctl_default vcio_device:chr_file ioctl 0x6400;
+
+# autoboot.txt is rewritten in place on the bootsel partition
+allow hal_bootctl_default block_device:dir search;
+allow hal_bootctl_default rpi_bootsel_block_device:blk_file rw_file_perms;
+
+# Which partition the firmware booted from, and whether it was a tryboot
+allow hal_bootctl_default sysfs_rpi_bootloader:dir r_dir_perms;
+allow hal_bootctl_default sysfs_rpi_bootloader:file r_file_perms;
