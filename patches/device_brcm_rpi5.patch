diff --git a/sepolicy/init.te b/sepolicy/init.te
index 1da3af0..6274eb9 100644
--- a/sepolicy/init.te
+++ b/sepolicy/init.te
@@ -1,2 +1,11 @@
 allow init kernel:system module_request;
 allow init tmpfs:lnk_file create;
+
+# init.rpi5.rc bind-mounts vendor/etc/security/otacerts_ladrok.zip over
+# /system/etc/security/otacerts.zip so update_engine trusts only our OTA key. Without this the
+# mount fails under enforcing, the public AOSP test key stays trusted and our OTAs are refused.
+allow init system_file:file mounton;
+
+# init.rc writes /dev/sys/block/by-name/{userdata,rootdisk}/queue/discard_max_bytes; on the SD
+# card that is the mmc host's sysfs tree (labelled sysfs_devices_block in genfs_contexts).
+allow init sysfs_devices_block:file w_file_perms;
