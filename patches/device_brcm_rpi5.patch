+    <!-- Ladrok Launcher, the home screen: built into the image, and updated from its GitHub
+         releases between system updates (LauncherUpdate). Empty launcher_repo disables that.
+         The certificate digest must match scripts/fetch-prebuilts.sh (CERT_SHA256). -->
+    <string name="launcher_repo" translatable="false">Kordal/ladrok-start</string>
+    <string name="launcher_package" translatable="false">tv.ladrok.launcher</string>
+    <string name="launcher_cert_sha256" translatable="false">00d9faeb7a77c0d3edcc6f9ba807b7061faa49fb6c60daf808dc79c9ee6ac43e</string>
+</resources>
