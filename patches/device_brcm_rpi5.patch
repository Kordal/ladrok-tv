+//
+// SPDX-License-Identifier: Apache-2.0
+//
+// First-boot setup for the Raspberry Pi 5 TV build: language, country (Wi-Fi regulatory
+// domain) and time zone. Replaces TvProvision, which only set the provisioned flags.
+
+prebuilt_etc {
+    name: "privapp_whitelist_tv.ladrok.setup",
+    system_ext_specific: true,
+    sub_dir: "permissions",
+    src: "tv.ladrok.setup.xml",
+    filename_from_src: true,
+}
+
+android_app {
+    name: "LadrokSetup",
+    srcs: ["src/**/*.java"],
+    resource_dirs: ["res"],
+    platform_apis: true,
+    system_ext_specific: true,
+    certificate: "platform",
+    privileged: true,
+    overrides: [
+        "SdkSetup",
+        "TvProvision",
+    ],
+    static_libs: [
+        "androidx.leanback_leanback",
+    ],
+    required: ["privapp_whitelist_tv.ladrok.setup"],
+    optimize: {
+        enabled: false,
+    },
+}
