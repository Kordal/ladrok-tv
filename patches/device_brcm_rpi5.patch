@@ -0,0 +1,42 @@
+/*
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package tv.ladrok.setup;
+
+import android.os.Bundle;
+
+import androidx.annotation.NonNull;
+import androidx.leanback.widget.GuidanceStylist.Guidance;
+import androidx.leanback.widget.GuidedAction;
+
+import java.util.List;
+import java.util.Locale;
+
+public class ConfirmStep extends BaseStep {
+    @Override
+    @NonNull
+    public Guidance onCreateGuidance(Bundle savedInstanceState) {
+        SetupActivity setup = setup();
+        Locale ui = setup.locale;
+        return new Guidance(getString(R.string.confirm_title),
+                getString(R.string.confirm_desc,
+                        ui.getDisplayName(ui),
+                        CountryStep.name(setup.country, ui),
+                        TimeZoneStep.city(setup.timeZone, ui)),
+                getString(R.string.breadcrumb), null);
+    }
+
+    @Override
+    public void onCreateActions(@NonNull List<GuidedAction> actions, Bundle savedInstanceState) {
+        actions.add(new GuidedAction.Builder(requireContext())
+                .id(0)
+                .title(getString(R.string.confirm_finish))
+                .build());
+    }
+
+    @Override
+    public void onGuidedActionClicked(GuidedAction action) {
+        setup().finishSetup();
+    }
+}
diff --git a/LadrokSetup/src/tv/ladrok/setup/CountryStep.java b/LadrokSetup/src/tv/ladrok/setup/CountryStep.java
new file mode 100644
index 0000000..8e62f1a
--- /dev/null
+++ b/LadrokSetup/src/tv/ladrok/setup/CountryStep.java
@@ -0,0 +1,107 @@
+/*
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package tv.ladrok.setup;
+
+import android.os.Bundle;
+
+import androidx.annotation.NonNull;
+import androidx.leanback.widget.GuidanceStylist.Guidance;
+import androidx.leanback.widget.GuidedAction;
+
+import java.text.Collator;
+import java.text.Normalizer;
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.List;
+import java.util.Locale;
+import java.util.Map;
+import java.util.Set;
+import java.util.TreeMap;
+
+/**
+ * Country of the TV: Wi-Fi regulatory domain and time zone filter.
+ * The suggested country comes first; the rest are grouped by first letter so a remote doesn't
+ * have to scroll through ~250 entries.
+ */
+public class CountryStep extends BaseStep {
+    /** Action ids below this are indexes into mCodes; letter groups use ids above it. */
+    private static final int GROUP_ID_BASE = 10000;
+
+    private final List<String> mCodes = new ArrayList<>();
+
+    @Override
+    @NonNull
+    public Guidance onCreateGuidance(Bundle savedInstanceState) {
+        return new Guidance(getString(R.string.country_title), getString(R.string.country_desc),
+                getString(R.string.breadcrumb), null);
+    }
+
+    @Override
+    public void onCreateActions(@NonNull List<GuidedAction> actions, Bundle savedInstanceState) {
+        Locale ui = setup().locale;
+        Collator collator = Collator.getInstance(ui);
+        mCodes.addAll(Arrays.asList(Locale.getISOCountries()));
+        mCodes.sort((a, b) -> collator.compare(name(a, ui), name(b, ui)));
+
+        String suggested = likelyCountry(ui);
+        int suggestedIndex = mCodes.indexOf(suggested);
+        if (suggestedIndex >= 0) {
+            actions.add(choice(suggestedIndex, name(suggested, ui), null));
+        }
+
+        // First letter -> its countries, in display order.
+        Map<String, List<GuidedAction>> groups = new TreeMap<>(collator);
+        for (int i = 0; i < mCodes.size(); i++) {
+            String name = name(mCodes.get(i), ui);
+            groups.computeIfAbsent(initial(name, ui), k -> new ArrayList<>())
+                    .add(choice(i, name, null));
+        }
+        int group = GROUP_ID_BASE;
+        for (Map.Entry<String, List<GuidedAction>> e : groups.entrySet()) {
+            actions.add(new GuidedAction.Builder(requireContext())
+                    .id(group++)
+                    .title(e.getKey())
+                    .subActions(e.getValue())
+                    .build());
+        }
+    }
+
+    @Override
+    public void onGuidedActionClicked(GuidedAction action) {
+        if (action.getId() < GROUP_ID_BASE) {
+            choose((int) action.getId());
+        }
+    }
+
+    @Override
+    public boolean onSubGuidedActionClicked(GuidedAction action) {
+        choose((int) action.getId());
+        return true;
+    }
+
+    private void choose(int index) {
+        SetupActivity setup = setup();
+        setup.country = mCodes.get(index);
+        Set<String> zones = TimeZoneStep.zonesFor(setup.country);
+        if (zones.size() == 1) {
+            setup.timeZone = zones.iterator().next();
+            next(new ConfirmStep());
+        } else {
+            next(new TimeZoneStep());
+        }
+    }
+
+    /** Index letter of a name without accents, e.g. "Åland Islands" -> "A". */
+    private static String initial(String name, Locale ui) {
+        String base = Normalizer.normalize(name, Normalizer.Form.NFD);
+        int cp = base.isEmpty() ? '#' : base.codePointAt(0);
+        return new String(Character.toChars(cp)).toUpperCase(ui);
+    }
+
+    /** Display name of an ISO 3166 country code. */
+    static String name(String code, Locale ui) {
+        return new Locale("", code).getDisplayCountry(ui);
+    }
+}
