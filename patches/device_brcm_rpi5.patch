diff --git a/LadrokLauncher/Android.bp b/LadrokLauncher/Android.bp
new file mode 100644
index 0000000..1c2356a
--- /dev/null
+++ b/LadrokLauncher/Android.bp
@@ -0,0 +1,46 @@
+//
+// SPDX-License-Identifier: Apache-2.0
+//
+// Ladrok Launcher (https://github.com/Kordal/ladrok-start): the home screen of Ladrok TV.
+// Built with Gradle in its own repo and signed there; scripts/fetch-prebuilts.sh in the drot repo
+// downloads the newest release APK (checked against the pinned signing certificate) into this directory.
+// Privileged, so it can read what any App's player is playing (MEDIA_CONTENT_CONTROL) for its
+// Continue card. A privileged permission the Launcher starts asking for must be added to
+// tv.ladrok.launcher.xml first, or the system refuses to boot.
+
+prebuilt_etc {
+    name: "default_permissions_tv.ladrok.launcher",
+    system_ext_specific: true,
+    sub_dir: "default-permissions",
+    src: "default-permissions-tv.ladrok.launcher.xml",
+    filename_from_src: true,
+}
+
+prebuilt_etc {
+    name: "privapp_whitelist_tv.ladrok.launcher",
+    system_ext_specific: true,
+    sub_dir: "permissions",
+    src: "tv.ladrok.launcher.xml",
+    filename_from_src: true,
+}
+
+android_app_import {
+    name: "LadrokLauncher",
+    apk: "LadrokLauncher.apk",
+    presigned: true,
+    // Signed with APK signature v2+, so the build must leave the file untouched
+    preprocessed: true,
+    privileged: true,
+    system_ext_specific: true,
+    // Declared by androidx.window in the manifest; neither exists on a TV
+    optional_uses_libs: [
+        "androidx.window.extensions",
+        "androidx.window.sidecar",
+    ],
+    // The only home app, so there is no "choose a launcher" prompt
+    overrides: ["TvSampleLeanbackLauncher"],
+    required: [
+        "default_permissions_tv.ladrok.launcher",
+        "privapp_whitelist_tv.ladrok.launcher",
+    ],
+}
