diff --git a/sepolicy_system_ext/app.te b/sepolicy_system_ext/app.te
new file mode 100644
index 0000000..5a2c40e
--- /dev/null
+++ b/sepolicy_system_ext/app.te
@@ -0,0 +1,5 @@
+# audioserver hands each AudioTrack its control block as a memfd labelled audioserver_tmpfs.
+# Without this, apps get "createTrack_l(0): Could not get control block" and play no sound
+# (avc: denied { write } untrusted_app -> audioserver_tmpfs, path memfd:MemoryHeapBase).
+# Platform policy, not vendor sepolicy/: audioserver_tmpfs is a platform-private type.
+allow { appdomain -isolated_app_all -sdk_sandbox_all } audioserver_tmpfs:file { getattr map read write };
