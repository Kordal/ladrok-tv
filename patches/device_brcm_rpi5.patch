diff --git a/LadrokRemoteHelper/src/tv/ladrok/remotehelper/RemoteHelperApp.java b/LadrokRemoteHelper/src/tv/ladrok/remotehelper/RemoteHelperApp.java
new file mode 100644
index 0000000..77c17e4
--- /dev/null
+++ b/LadrokRemoteHelper/src/tv/ladrok/remotehelper/RemoteHelperApp.java
@@ -0,0 +1,129 @@
+/*
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package tv.ladrok.remotehelper;
+
+import android.app.Application;
+import android.bluetooth.BluetoothAdapter;
+import android.bluetooth.BluetoothDevice;
+import android.bluetooth.BluetoothHidHost;
+import android.bluetooth.BluetoothManager;
+import android.bluetooth.BluetoothProfile;
+import android.content.BroadcastReceiver;
+import android.content.Context;
+import android.content.Intent;
+import android.content.IntentFilter;
+import android.content.SharedPreferences;
+import android.os.ParcelUuid;
+import android.util.Log;
+
+import java.util.HashSet;
+import java.util.Set;
+
+/**
+ * Makes the TV's HID host connect once to each newly paired device that offers HID, such as a
+ * phone running Ladrok Remote. The HID host rejects incoming connections from devices it has
+ * never connected to itself; after this first connection it keeps the device's HID details
+ * and accepts the device's own connections from then on, also after a reboot.
+ */
+public class RemoteHelperApp extends Application {
+    private static final String TAG = "LadrokRemoteHelper";
+    private static final ParcelUuid HID =
+            ParcelUuid.fromString("00001124-0000-1000-8000-00805f9b34fb");
+    // Addresses connected since they were paired; an address is removed when it is unpaired
+    private static final String PREFS = "connected";
+
+    private final Set<String> mPending = new HashSet<>();
+    private SharedPreferences mConnected;
+
+    @Override
+    public void onCreate() {
+        super.onCreate();
+        mConnected = getSharedPreferences(PREFS, MODE_PRIVATE);
+        IntentFilter filter = new IntentFilter();
+        filter.addAction(BluetoothDevice.ACTION_BOND_STATE_CHANGED);
+        filter.addAction(BluetoothDevice.ACTION_UUID);
+        // Sent by the Bluetooth app, not the system; both are protected broadcasts
+        registerReceiver(mReceiver, filter, Context.RECEIVER_EXPORTED);
+    }
+
+    private final BroadcastReceiver mReceiver = new BroadcastReceiver() {
+        @Override
+        public void onReceive(Context context, Intent intent) {
+            BluetoothDevice device =
+                    intent.getParcelableExtra(BluetoothDevice.EXTRA_DEVICE, BluetoothDevice.class);
+            if (device == null) return;
+            if (BluetoothDevice.ACTION_BOND_STATE_CHANGED.equals(intent.getAction())) {
+                int state = intent.getIntExtra(BluetoothDevice.EXTRA_BOND_STATE,
+                        BluetoothDevice.ERROR);
+                if (state == BluetoothDevice.BOND_NONE) {
+                    mConnected.edit().remove(device.getAddress()).apply();
+                } else if (state == BluetoothDevice.BOND_BONDED) {
+                    // The UUIDs usually come with pairing. If not, ACTION_UUID follows.
+                    if (device.getUuids() == null) {
+                        device.fetchUuidsWithSdp();
+                    } else {
+                        maybeConnect(device);
+                    }
+                }
+            } else if (device.getBondState() == BluetoothDevice.BOND_BONDED) {
+                maybeConnect(device);
+            }
+        }
+    };
+
+    private void maybeConnect(BluetoothDevice device) {
+        String address = device.getAddress();
+        if (mConnected.contains(address) || mPending.contains(address)) return;
+        if (!hasHid(device.getUuids())) return;
+
+        BluetoothAdapter adapter = getSystemService(BluetoothManager.class).getAdapter();
+        if (adapter == null) return;
+        mPending.add(address);
+        boolean ok = adapter.getProfileProxy(this, new BluetoothProfile.ServiceListener() {
+            @Override
+            public void onServiceConnected(int profile, BluetoothProfile proxy) {
+                mPending.remove(address);
+                connect((BluetoothHidHost) proxy, device);
+                adapter.closeProfileProxy(BluetoothProfile.HID_HOST, proxy);
+            }
+
+            @Override
+            public void onServiceDisconnected(int profile) {
+                mPending.remove(address);
+            }
+        }, BluetoothProfile.HID_HOST);
+        if (!ok) {
+            mPending.remove(address);
+            Log.w(TAG, "No HID host proxy");
+        }
+    }
+
+    private void connect(BluetoothHidHost hid, BluetoothDevice device) {
+        String address = device.getAddress();
+        int state = hid.getConnectionState(device);
+        if (state != BluetoothProfile.STATE_DISCONNECTED) {
+            // Something else, such as TV Settings for a real remote, is already connecting it
+            Log.i(TAG, device + " already in HID state " + state);
+            mConnected.edit().putBoolean(address, true).apply();
+            return;
+        }
+        // Saves the policy and connects (HidHostService.setConnectionPolicy). Also resumes the
+        // device's own incoming connection if the stack is holding it for us.
+        if (hid.setConnectionPolicy(device, BluetoothProfile.CONNECTION_POLICY_ALLOWED)) {
+            Log.i(TAG, "Connecting HID host to " + device);
+            mConnected.edit().putBoolean(address, true).apply();
+        } else {
+            Log.w(TAG, "Could not connect HID host to " + device);
+        }
+    }
+
+    private static boolean hasHid(ParcelUuid[] uuids) {
+        if (uuids == null) return false;
+        for (ParcelUuid uuid : uuids) {
+            if (HID.equals(uuid)) return true;
+        }
+        return false;
+    }
+}
