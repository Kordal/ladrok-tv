+//
+// SPDX-License-Identifier: Apache-2.0
+//
+// A/B boot control for the Raspberry Pi 5: slots are switched by the Pi firmware
+// (autoboot.txt + one-shot tryboot), not by a bootloader reading misc.
+
+cc_library_static {
+    name: "librpi_firmware",
+    vendor: true,
+    srcs: [
+        "autoboot.c",
+        "rpi_firmware.c",
+    ],
+    export_include_dirs: ["."],
+    cflags: ["-Wall", "-Werror"],
+}
+
+cc_binary {
+    name: "rpi_tryboot",
+    vendor: true,
+    srcs: ["rpi_tryboot.c"],
+    static_libs: ["librpi_firmware"],
+    cflags: ["-Wall", "-Werror"],
+}
+
+vintf_fragment {
+    name: "android.hardware.boot-service.rpi.xml",
+    src: "android.hardware.boot-service.rpi.xml",
+    vendor: true,
+}
+
+cc_binary {
+    name: "android.hardware.boot-service.rpi",
+    relative_install_path: "hw",
+    defaults: ["libboot_control_defaults"],
+    vendor: true,
+    srcs: [
+        "BootControl.cpp",
+        "main.cpp",
+    ],
+    init_rc: ["android.hardware.boot-service.rpi.rc"],
+    vintf_fragment_modules: ["android.hardware.boot-service.rpi.xml"],
+    stl: "c++_static",
+    shared_libs: [
+        "libbinder_ndk",
+        "liblog",
+    ],
+    static_libs: [
+        "android.hardware.boot@1.1",
+        "android.hardware.boot-V1-ndk",
+        "libbase",
+        "libboot_control",
+        "librpi_firmware",
+    ],
+}
diff --git a/boot_control/BootControl.cpp b/boot_control/BootControl.cpp
new file mode 100644
index 0000000..1a64e7a
--- /dev/null
+++ b/boot_control/BootControl.cpp
@@ -0,0 +1,200 @@
+/*
+ * SPDX-License-Identifier: Apache-2.0
+ *
+ * Based on hardware/interfaces/boot/aidl/default/BootControl.cpp.
+ */
+
+#include "BootControl.h"
+
+#include <cstdint>
+#include <cstring>
+
+#include <android-base/logging.h>
+
+#include "autoboot.h"
+#include "rpi_firmware.h"
+
+using HIDLMergeStatus = ::android::bootable::BootControl::MergeStatus;
+using ndk::ScopedAStatus;
+
+namespace aidl::android::hardware::boot {
+
+namespace {
+
+constexpr char kBootselDevice[] = "/dev/block/by-name/bootsel";
+
+ScopedAStatus InvalidSlot(int32_t slot) {
+    return ScopedAStatus::fromServiceSpecificErrorWithMessage(
+            IBootControl::INVALID_SLOT,
+            (std::string("Invalid slot ") + std::to_string(slot)).c_str());
+}
+
+ScopedAStatus Failed() {
+    return ScopedAStatus::fromServiceSpecificErrorWithMessage(IBootControl::COMMAND_FAILED,
+                                                              "Operation failed");
+}
+
+constexpr MergeStatus ToAIDLMergeStatus(HIDLMergeStatus status) {
+    switch (status) {
+        case HIDLMergeStatus::NONE:
+            return MergeStatus::NONE;
+        case HIDLMergeStatus::UNKNOWN:
+            return MergeStatus::UNKNOWN;
+        case HIDLMergeStatus::SNAPSHOTTED:
+            return MergeStatus::SNAPSHOTTED;
+        case HIDLMergeStatus::MERGING:
+            return MergeStatus::MERGING;
+        case HIDLMergeStatus::CANCELLED:
+            return MergeStatus::CANCELLED;
+    }
+}
+
+constexpr HIDLMergeStatus ToHIDLMergeStatus(MergeStatus status) {
+    switch (status) {
+        case MergeStatus::NONE:
+            return HIDLMergeStatus::NONE;
+        case MergeStatus::UNKNOWN:
+            return HIDLMergeStatus::UNKNOWN;
+        case MergeStatus::SNAPSHOTTED:
+            return HIDLMergeStatus::SNAPSHOTTED;
+        case MergeStatus::MERGING:
+            return HIDLMergeStatus::MERGING;
+        case MergeStatus::CANCELLED:
+            return HIDLMergeStatus::CANCELLED;
+    }
+}
+
+}  // namespace
+
+BootControl::BootControl() {
+    CHECK(impl_.Init());
+    unsigned int current = impl_.GetCurrentSlot();
+    LOG(INFO) << "current slot " << impl_.GetSuffix(current) << ", firmware partition "
+              << rpi_booted_partition() << (rpi_booted_tryboot() == 1 ? " (tryboot)" : "")
+              << ", autoboot default " << autoboot_read_all_partition(kBootselDevice);
+    if (rpi_booted_partition() != SlotPartition(current)) {
+        LOG(WARNING) << "slot suffix and firmware boot partition disagree";
+    }
+    ReconcileAfterFallback();
+}
+
+void BootControl::ReconcileAfterFallback() {
+    unsigned int current = impl_.GetCurrentSlot();
+    unsigned int active = impl_.GetActiveBootSlot();
+    if (active == current || impl_.IsSlotMarkedSuccessful(active)) return;
+    // A tryboot of `active` is still armed: the update is waiting for its reboot.
+    if (rpi_get_tryboot() == 1) return;
+    // The other slot was made active but we booted the current one without tryboot: the
+    // tryboot failed (or the flag was lost on power-off). Roll back to the running slot.
+    LOG(WARNING) << "slot " << impl_.GetSuffix(active) << " did not boot; staying on "
+                 << impl_.GetSuffix(current);
+    impl_.SetSlotAsUnbootable(active);
+    impl_.SetActiveBootSlot(current);
+}
+
+bool BootControl::CommitSlot(unsigned int slot) {
+    int other = SlotPartition(1 - slot);
+    int r = autoboot_write(kBootselDevice, SlotPartition(slot), other);
+    if (r < 0) {
+        LOG(ERROR) << "writing autoboot.txt failed: " << strerror(-r);
+        return false;
+    }
+    return true;
+}
+
+ScopedAStatus BootControl::getActiveBootSlot(int32_t* _aidl_return) {
+    *_aidl_return = impl_.GetActiveBootSlot();
+    return ScopedAStatus::ok();
+}
+
+ScopedAStatus BootControl::getCurrentSlot(int32_t* _aidl_return) {
+    *_aidl_return = impl_.GetCurrentSlot();
+    return ScopedAStatus::ok();
+}
+
+ScopedAStatus BootControl::getNumberSlots(int32_t* _aidl_return) {
+    *_aidl_return = impl_.GetNumberSlots();
+    return ScopedAStatus::ok();
+}
+
+ScopedAStatus BootControl::getSnapshotMergeStatus(MergeStatus* _aidl_return) {
+    *_aidl_return = ToAIDLMergeStatus(impl_.GetSnapshotMergeStatus());
+    return ScopedAStatus::ok();
+}
+
+ScopedAStatus BootControl::getSuffix(int32_t in_slot, std::string* _aidl_return) {
+    if (!impl_.IsValidSlot(in_slot)) {
+        // Like the HIDL HAL: empty string for invalid slots.
+        _aidl_return->clear();
+    } else {
+        *_aidl_return = impl_.GetSuffix(in_slot);
+    }
+    return ScopedAStatus::ok();
+}
+
+ScopedAStatus BootControl::isSlotBootable(int32_t in_slot, bool* _aidl_return) {
+    if (!impl_.IsValidSlot(in_slot)) return InvalidSlot(in_slot);
+    *_aidl_return = impl_.IsSlotBootable(in_slot);
+    return ScopedAStatus::ok();
+}
+
+ScopedAStatus BootControl::isSlotMarkedSuccessful(int32_t in_slot, bool* _aidl_return) {
+    if (!impl_.IsValidSlot(in_slot)) return InvalidSlot(in_slot);
+    *_aidl_return = impl_.IsSlotMarkedSuccessful(in_slot);
+    return ScopedAStatus::ok();
+}
+
+ScopedAStatus BootControl::markBootSuccessful() {
+    if (!impl_.MarkBootSuccessful()) return Failed();
+    unsigned int current = impl_.GetCurrentSlot();
+    // Only touch autoboot.txt when it doesn't already point at this slot (i.e. after a
+    // successful tryboot), to keep writes to the boot selector rare.
+    if (autoboot_read_all_partition(kBootselDevice) != SlotPartition(current)) {
+        LOG(INFO) << "slot " << impl_.GetSuffix(current) << " booted fine; making it the default";
+        if (!CommitSlot(current)) return Failed();
+    }
+    return ScopedAStatus::ok();
+}
+
+ScopedAStatus BootControl::setActiveBootSlot(int32_t in_slot) {
+    if (!impl_.IsValidSlot(in_slot)) return InvalidSlot(in_slot);
+    if (!impl_.SetActiveBootSlot(in_slot)) return Failed();
+
+    unsigned int current = impl_.GetCurrentSlot();
+    if (static_cast<unsigned int>(in_slot) == current) {
+        // Cancelling a pending switch: disarm the tryboot, keep booting this slot.
+        rpi_set_tryboot(0);
+        if (autoboot_read_all_partition(kBootselDevice) != SlotPartition(current) &&
+            !CommitSlot(current)) {
+            return Failed();
+        }
+        return ScopedAStatus::ok();
+    }
+
+    // Boot the new slot once; if it never calls markBootSuccessful (crash, hang + reset,
+    // power loss), the firmware boots the current slot again.
+    int r = autoboot_write(kBootselDevice, SlotPartition(current), SlotPartition(in_slot));
+    if (r == 0) r = rpi_set_tryboot(1);
+    if (r < 0) {
+        LOG(ERROR) << "arming tryboot of slot " << impl_.GetSuffix(in_slot)
+                   << " failed: " << strerror(-r);
+        return Failed();
+    }
+    LOG(INFO) << "next boot tries slot " << impl_.GetSuffix(in_slot);
+    return ScopedAStatus::ok();
+}
+
+ScopedAStatus BootControl::setSlotAsUnbootable(int32_t in_slot) {
+    if (!impl_.IsValidSlot(in_slot)) return InvalidSlot(in_slot);
+    if (!impl_.SetSlotAsUnbootable(in_slot)) return Failed();
+    // update_engine does this before writing the slot: never tryboot a half-written slot.
+    if (static_cast<unsigned int>(in_slot) != impl_.GetCurrentSlot()) rpi_set_tryboot(0);
+    return ScopedAStatus::ok();
+}
+
+ScopedAStatus BootControl::setSnapshotMergeStatus(MergeStatus in_status) {
+    if (!impl_.SetSnapshotMergeStatus(ToHIDLMergeStatus(in_status))) return Failed();
+    return ScopedAStatus::ok();
+}
+
+}  // namespace aidl::android::hardware::boot
diff --git a/boot_control/BootControl.h b/boot_control/BootControl.h
new file mode 100644
index 0000000..b501600
--- /dev/null
+++ b/boot_control/BootControl.h
@@ -0,0 +1,48 @@
+/*
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+#pragma once
+
+#include <aidl/android/hardware/boot/BnBootControl.h>
+#include <libboot_control/libboot_control.h>
+
+namespace aidl::android::hardware::boot {
+
+/*
+ * AOSP's default boot control (slot metadata in misc, via libboot_control) plus the Pi part:
+ * the firmware doesn't read misc, it boots the partition named in autoboot.txt, or the
+ * [tryboot] one once after the tryboot flag is set. So:
+ *  - setActiveBootSlot(other) arms a one-shot tryboot into the other slot; a failed boot of it
+ *    falls back to the current slot on the next reset;
+ *  - markBootSuccessful() on a tryboot makes the current slot the permanent default.
+ */
+class BootControl final : public BnBootControl {
+  public:
+    BootControl();
+    ::ndk::ScopedAStatus getActiveBootSlot(int32_t* _aidl_return) override;
+    ::ndk::ScopedAStatus getCurrentSlot(int32_t* _aidl_return) override;
+    ::ndk::ScopedAStatus getNumberSlots(int32_t* _aidl_return) override;
+    ::ndk::ScopedAStatus getSnapshotMergeStatus(
+            ::aidl::android::hardware::boot::MergeStatus* _aidl_return) override;
+    ::ndk::ScopedAStatus getSuffix(int32_t in_slot, std::string* _aidl_return) override;
+    ::ndk::ScopedAStatus isSlotBootable(int32_t in_slot, bool* _aidl_return) override;
+    ::ndk::ScopedAStatus isSlotMarkedSuccessful(int32_t in_slot, bool* _aidl_return) override;
+    ::ndk::ScopedAStatus markBootSuccessful() override;
+    ::ndk::ScopedAStatus setActiveBootSlot(int32_t in_slot) override;
+    ::ndk::ScopedAStatus setSlotAsUnbootable(int32_t in_slot) override;
+    ::ndk::ScopedAStatus setSnapshotMergeStatus(
+            ::aidl::android::hardware::boot::MergeStatus in_status) override;
+
+  private:
+    /* Firmware partition number of a slot's rpiboot partition (GPT entry 2 or 3). */
+    static int SlotPartition(unsigned int slot) { return 2 + slot; }
+    /* Makes autoboot.txt boot `slot` by default. */
+    bool CommitSlot(unsigned int slot);
+    /* After a failed tryboot the firmware is back on the old slot; make misc agree. */
+    void ReconcileAfterFallback();
+
+    ::android::bootable::BootControl impl_;
+};
+
+}  // namespace aidl::android::hardware::boot
