+//
+// SPDX-License-Identifier: Apache-2.0
+//
+// Ladrok Store (https://github.com/Kordal/ladrok-store): the app store. Built with Gradle in its
+// own repo and signed there; scripts/fetch-prebuilts.sh in the drot repo downloads the newest
+// release APK (checked against the pinned signing certificate) into this directory.
+// Privileged, so it installs and updates its Apps without asking.
+
+prebuilt_etc {
+    name: "privapp_whitelist_tv.ladrok.store",
+    system_ext_specific: true,
+    sub_dir: "permissions",
+    src: "tv.ladrok.store.xml",
+    filename_from_src: true,
+}
+
+android_app_import {
+    name: "LadrokStore",
+    apk: "LadrokStore.apk",
+    presigned: true,
+    // Signed with APK signature v2+, so the build must leave the file untouched
+    preprocessed: true,
+    privileged: true,
+    system_ext_specific: true,
+    // Declared by androidx.window in the manifest; neither exists on a TV
+    optional_uses_libs: [
+        "androidx.window.extensions",
+        "androidx.window.sidecar",
+    ],
+    required: ["privapp_whitelist_tv.ladrok.store"],
+}
