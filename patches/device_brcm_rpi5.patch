+/*
+ * SPDX-License-Identifier: Apache-2.0
+ *
+ * Based on hardware/interfaces/boot/aidl/default/main.cpp.
+ */
+
+#include "BootControl.h"
+
+#include <android-base/logging.h>
+#include <android/binder_manager.h>
+#include <android/binder_process.h>
+
+using aidl::android::hardware::boot::BootControl;
+using aidl::android::hardware::boot::IBootControl;
+
+int main(int, char* argv[]) {
+    android::base::InitLogging(argv, android::base::KernelLogger);
+    ABinderProcess_setThreadPoolMaxThreadCount(0);
+    std::shared_ptr<IBootControl> service = ndk::SharedRefBase::make<BootControl>();
+
+    const std::string instance = std::string(BootControl::descriptor) + "/default";
+    auto status = AServiceManager_addService(service->asBinder().get(), instance.c_str());
+    CHECK_EQ(status, STATUS_OK) << "Failed to add service " << instance << " " << status;
+    LOG(INFO) << "IBootControl AIDL service (rpi) running";
+
+    ABinderProcess_joinThreadPool();
+    return EXIT_FAILURE;  // should not reach
+}
diff --git a/boot_control/rpi_firmware.c b/boot_control/rpi_firmware.c
new file mode 100644
index 0000000..7ab992e
--- /dev/null
+++ b/boot_control/rpi_firmware.c
@@ -0,0 +1,65 @@
+/*
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+#include "rpi_firmware.h"
+
+#include <errno.h>
+#include <fcntl.h>
+#include <stdint.h>
+#include <sys/ioctl.h>
+#include <unistd.h>
+
+#define IOCTL_MBOX_PROPERTY _IOWR(100, 0, char *)
+#define TAG_GET_REBOOT_FLAGS 0x00030064
+#define TAG_SET_REBOOT_FLAGS 0x00038064
+#define REBOOT_FLAG_TRYBOOT 0x1
+#define MBOX_SUCCESS 0x80000000u
+
+/* One-tag property request; returns the tag's 32-bit value or -errno. */
+static int64_t mbox_call(uint32_t tag, uint32_t value) {
+    uint32_t buf[7] = {
+        sizeof(buf), 0,  /* buffer size, request code */
+        tag, 4, 0,       /* tag, value size, request/response */
+        value,
+        0,               /* end tag */
+    };
+    int fd = open("/dev/vcio", O_RDWR | O_CLOEXEC);
+    if (fd < 0) return -errno;
+    int ret = ioctl(fd, IOCTL_MBOX_PROPERTY, buf);
+    int err = errno;
+    close(fd);
+    if (ret < 0) return -err;
+    if (buf[1] != MBOX_SUCCESS) return -EIO;
+    return buf[5];
+}
+
+int rpi_set_tryboot(int enable) {
+    int64_t r = mbox_call(TAG_SET_REBOOT_FLAGS, enable ? REBOOT_FLAG_TRYBOOT : 0);
+    return r < 0 ? (int)r : 0;
+}
+
+int rpi_get_tryboot(void) {
+    int64_t r = mbox_call(TAG_GET_REBOOT_FLAGS, 0);
+    return r < 0 ? (int)r : (int)(r & REBOOT_FLAG_TRYBOOT);
+}
+
+/* Device-tree properties are big-endian u32. */
+static int read_dt_u32(const char *path) {
+    uint8_t b[4];
+    int fd = open(path, O_RDONLY | O_CLOEXEC);
+    if (fd < 0) return -errno;
+    ssize_t n = read(fd, b, sizeof(b));
+    int err = errno;
+    close(fd);
+    if (n != sizeof(b)) return n < 0 ? -err : -EINVAL;
+    return (int)((uint32_t)b[0] << 24 | (uint32_t)b[1] << 16 | (uint32_t)b[2] << 8 | b[3]);
+}
+
+int rpi_booted_partition(void) {
+    return read_dt_u32("/proc/device-tree/chosen/bootloader/partition");
+}
+
+int rpi_booted_tryboot(void) {
+    return read_dt_u32("/proc/device-tree/chosen/bootloader/tryboot");
+}
