+++ b/LadrokSetup/src/tv/ladrok/setup/RegionStep.java
@@ -0,0 +1,56 @@
+/*
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package tv.ladrok.setup;
+
+import android.os.Bundle;
+
+import androidx.annotation.NonNull;
+import androidx.leanback.widget.GuidanceStylist.Guidance;
+import androidx.leanback.widget.GuidedAction;
+
+import com.android.internal.app.LocaleStore;
+
+import java.text.Collator;
+import java.util.ArrayList;
+import java.util.HashSet;
+import java.util.List;
+
+/** Regional variant of the chosen language, e.g. English (United Kingdom). */
+public class RegionStep extends BaseStep {
+    private final List<LocaleStore.LocaleInfo> mItems = new ArrayList<>();
+
+    @Override
+    @NonNull
+    public Guidance onCreateGuidance(Bundle savedInstanceState) {
+        return new Guidance(getString(R.string.region_title),
+                getString(R.string.region_desc, setup().language.getFullNameNative()),
+                getString(R.string.breadcrumb), null);
+    }
+
+    @Override
+    public void onCreateActions(@NonNull List<GuidedAction> actions, Bundle savedInstanceState) {
+        LocaleStore.LocaleInfo language = setup().language;
+        mItems.addAll(LocaleStore.getLevelLocales(
+                requireContext(), new HashSet<>(), language, true));
+        Collator collator = Collator.getInstance(language.getLocale());
+        mItems.sort((a, b) -> collator.compare(
+                a.getFullCountryNameNative(), b.getFullCountryNameNative()));
+
+        String likely = likelyCountry(language.getLocale());
+        for (int i = 0; i < mItems.size(); i++) {
+            LocaleStore.LocaleInfo li = mItems.get(i);
+            actions.add(choice(i, li.getFullCountryNameNative(), null));
+            if (li.getLocale().getCountry().equals(likely)) {
+                mInitialSelection = i;
+            }
+        }
+    }
+
+    @Override
+    public void onGuidedActionClicked(GuidedAction action) {
+        setup().locale = mItems.get((int) action.getId()).getLocale();
+        next(new CountryStep());
+    }
+}
