@@ -26,6 +26,23 @@ TARGET_SCREEN_DENSITY := 240
 BOARD_CUSTOM_BOOTIMG := true
 BOARD_CUSTOM_BOOTIMG_MK := $(DEVICE_PATH)/mkbootimg.mk
 BOARD_KERNEL_CMDLINE := console=ttyAMA10,115200 androidboot.hardware=rpi5 androidboot.verifiedbootstate=orange
+# SD card controller: init creates /dev/block/by-name/* (GPT names) for partitions on it
+BOARD_KERNEL_CMDLINE += androidboot.boot_devices=soc@107c000000/1000fff000.mmc
+# Reboot on panic, so a broken slot falls back to the other one (tryboot is one-shot)
+BOARD_KERNEL_CMDLINE += panic=10
+# ro.boot.* properties can only come from the bootloader/cmdline, not from vendor.prop
+BOARD_KERNEL_CMDLINE += androidboot.audio.tinyalsa.simulate_input=true
