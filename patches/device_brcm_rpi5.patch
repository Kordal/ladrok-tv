+++ b/LadrokSetup/src/tv/ladrok/setup/SetupActivity.java
@@ -0,0 +1,106 @@
+/*
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package tv.ladrok.setup;
+
+import android.app.AlarmManager;
+import android.app.timezonedetector.TimeZoneDetector;
+import android.content.ComponentName;
+import android.content.ContentResolver;
+import android.content.pm.PackageManager;
+import android.net.wifi.WifiManager;
+import android.os.Bundle;
+import android.os.UserManager;
+import android.provider.Settings;
+import android.util.Log;
+
+import androidx.fragment.app.FragmentActivity;
+import androidx.leanback.app.GuidedStepSupportFragment;
+
+import com.android.internal.app.LocalePicker;
+import com.android.internal.app.LocaleStore;
+
+import java.util.Locale;
+
+/**
+ * First-boot setup: language -> region -> country -> time zone -> finish.
+ * Nothing is applied until Finish, so backing out of any step is free.
+ */
+public class SetupActivity extends FragmentActivity {
+    static final String TAG = "LadrokSetup";
+    private static final String TV_USER_SETUP_COMPLETE = "tv_user_setup_complete";
+
+    // Choices collected by the steps.
+    LocaleStore.LocaleInfo language;
+    Locale locale;
+    String country;
+    String timeZone;
+
+    @Override
+    protected void onCreate(Bundle savedInstanceState) {
+        // The choices live in fields, so never restore steps from a saved state; start over.
+        super.onCreate(null);
+        if (Settings.Secure.getInt(getContentResolver(), TV_USER_SETUP_COMPLETE, 0) == 1) {
+            // Already set up (e.g. this app arrived through an update): don't ask again.
+            disableSelf();
+            finish();
+            return;
+        }
+        GuidedStepSupportFragment.addAsRoot(this, new LanguageStep(), android.R.id.content);
+    }
+
+    private void disableSelf() {
+        getPackageManager().setComponentEnabledSetting(
+                new ComponentName(this, SetupActivity.class),
+                PackageManager.COMPONENT_ENABLED_STATE_DISABLED, PackageManager.DONT_KILL_APP);
+    }
+
+    @Override
+    public void onBackPressed() {
+        // Back on the first step would leave setup unfinished; ignore it.
+        if (getSupportFragmentManager().getBackStackEntryCount() == 0) {
+            return;
+        }
+        super.onBackPressed();
+    }
+
+    void finishSetup() {
+        Log.i(TAG, "finish: locale=" + locale.toLanguageTag() + " country=" + country
+                + " timeZone=" + timeZone);
+        ContentResolver cr = getContentResolver();
+
+        // Persistent Wi-Fi regulatory domain (stored in WifiConfigStore, survives reboots).
+        try {
+            getSystemService(WifiManager.class).setDefaultCountryCode(country);
+        } catch (RuntimeException e) {
+            Log.e(TAG, "setDefaultCountryCode failed", e);
+        }
+
+        // No telephony or location provider, so automatic time zone detection can't work.
+        Settings.Global.putInt(cr, Settings.Global.AUTO_TIME_ZONE, 0);
+        boolean tzSet = false;
+        try {
+            tzSet = getSystemService(TimeZoneDetector.class).suggestManualTimeZone(
+                    TimeZoneDetector.createManualTimeZoneSuggestion(timeZone, TAG));
+        } catch (RuntimeException e) {
+            Log.e(TAG, "suggestManualTimeZone failed", e);
+        }
+        if (!tzSet) {
+            getSystemService(AlarmManager.class).setTimeZone(timeZone);
+        }
+
+        // Same flags TvProvision sets.
+        if (!getSystemService(UserManager.class).isRestrictedProfile()) {
+            Settings.Global.putInt(cr, Settings.Global.DEVICE_PROVISIONED, 1);
+        }
+        Settings.Secure.putInt(cr, Settings.Secure.USER_SETUP_COMPLETE, 1);
+        Settings.Secure.putInt(cr, TV_USER_SETUP_COMPLETE, 1);
+
+        disableSelf();
+        finish();
+
+        // Last, because it changes the configuration of everything that is running.
+        LocalePicker.updateLocale(locale);
+    }
+}
diff --git a/LadrokSetup/src/tv/ladrok/setup/TimeZoneStep.java b/LadrokSetup/src/tv/ladrok/setup/TimeZoneStep.java
new file mode 100644
index 0000000..8bf0b21
--- /dev/null
+++ b/LadrokSetup/src/tv/ladrok/setup/TimeZoneStep.java
@@ -0,0 +1,89 @@
+/*
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package tv.ladrok.setup;
+
+import android.icu.text.TimeZoneNames;
+import android.icu.util.TimeZone;
+import android.icu.util.ULocale;
+import android.os.Bundle;
+
+import androidx.annotation.NonNull;
+import androidx.leanback.widget.GuidanceStylist.Guidance;
+import androidx.leanback.widget.GuidedAction;
+
+import java.text.Collator;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Locale;
+import java.util.Set;
+
+public class TimeZoneStep extends BaseStep {
+    private final List<String> mIds = new ArrayList<>();
+
+    /** Canonical time zones of a country; every zone if the country has none. */
+    static Set<String> zonesFor(String country) {
+        Set<String> zones = TimeZone.getAvailableIDs(
+                TimeZone.SystemTimeZoneType.CANONICAL_LOCATION, country, null);
+        if (zones.isEmpty()) {
+            zones = TimeZone.getAvailableIDs(
+                    TimeZone.SystemTimeZoneType.CANONICAL_LOCATION, null, null);
+        }
+        return zones;
+    }
+
+    /** City name of a zone, e.g. "Europe/Brussels" -> "Brussels" (in the chosen language). */
+    static String city(String id, Locale ui) {
+        String city = TimeZoneNames.getInstance(ULocale.forLocale(ui)).getExemplarLocationName(id);
+        return city != null ? city : id.substring(id.lastIndexOf('/') + 1).replace('_', ' ');
+    }
+
+    @Override
+    @NonNull
+    public Guidance onCreateGuidance(Bundle savedInstanceState) {
+        return new Guidance(getString(R.string.timezone_title), getString(R.string.timezone_desc),
+                getString(R.string.breadcrumb), null);
+    }
+
+    @Override
+    public void onCreateActions(@NonNull List<GuidedAction> actions, Bundle savedInstanceState) {
+        Locale ui = setup().locale;
+        TimeZoneNames names = TimeZoneNames.getInstance(ULocale.forLocale(ui));
+        long now = System.currentTimeMillis();
+        Collator collator = Collator.getInstance(ui);
+
+        mIds.addAll(zonesFor(setup().country));
+        mIds.sort((a, b) -> {
+            int byOffset = Integer.compare(offset(a, now), offset(b, now));
+            return byOffset != 0 ? byOffset : collator.compare(city(a, ui), city(b, ui));
+        });
+
+        String current = java.util.TimeZone.getDefault().getID();
+        for (int i = 0; i < mIds.size(); i++) {
+            String id = mIds.get(i);
+            String generic = names.getDisplayName(id, TimeZoneNames.NameType.LONG_GENERIC, now);
+            String desc = gmt(offset(id, now)) + (generic != null ? "  " + generic : "");
+            actions.add(choice(i, city(id, ui), desc));
+            if (id.equals(current)) {
+                mInitialSelection = i;
+            }
+        }
+    }
+
+    @Override
+    public void onGuidedActionClicked(GuidedAction action) {
+        setup().timeZone = mIds.get((int) action.getId());
+        next(new ConfirmStep());
+    }
+
+    private static int offset(String id, long now) {
+        return java.util.TimeZone.getTimeZone(id).getOffset(now);
+    }
+
+    private static String gmt(int offsetMs) {
+        int minutes = Math.abs(offsetMs) / 60000;
+        return String.format(Locale.ROOT, "GMT%c%02d:%02d",
+                offsetMs < 0 ? '-' : '+', minutes / 60, minutes % 60);
+    }
+}
