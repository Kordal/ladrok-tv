+    platform_apis: true,
+    system_ext_specific: true,
+    certificate: "platform",
+    privileged: true,
+    static_libs: [
+        "androidx.leanback_leanback",
+    ],
+    required: ["privapp_whitelist_tv.ladrok.updater"],
+    optimize: {
