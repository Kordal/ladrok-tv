@@ -0,0 +1,85 @@
+/*
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package tv.ladrok.setup;
+
+import android.os.Bundle;
+
+import androidx.annotation.NonNull;
+import androidx.leanback.widget.GuidanceStylist.Guidance;
+import androidx.leanback.widget.GuidedAction;
+
+import com.android.internal.app.LocaleStore;
+
+import java.text.Collator;
+import java.util.ArrayList;
+import java.util.HashSet;
+import java.util.List;
+import java.util.Locale;
+import java.util.Set;
+
+public class LanguageStep extends BaseStep {
+    private final List<LocaleStore.LocaleInfo> mItems = new ArrayList<>();
+
+    @Override
+    @NonNull
+    public Guidance onCreateGuidance(Bundle savedInstanceState) {
+        return new Guidance(getString(R.string.language_title), getString(R.string.language_desc),
+                getString(R.string.breadcrumb), null);
+    }
+
+    @Override
+    public void onCreateActions(@NonNull List<GuidedAction> actions, Bundle savedInstanceState) {
+        Set<LocaleStore.LocaleInfo> all =
+                LocaleStore.getLevelLocales(requireContext(), new HashSet<>(), null, true);
+        // The list also holds the current and suggested locales with their region
+        // ("English (United States)"); keep only the plain language, the region is the next step.
+        Set<String> plain = new HashSet<>();
+        for (LocaleStore.LocaleInfo li : all) {
+            if (li.getLocale().getCountry().isEmpty()) {
+                plain.add(languageKey(li.getLocale()));
+            }
+        }
+        for (LocaleStore.LocaleInfo li : all) {
+            if (li.getLocale().getCountry().isEmpty()
+                    || !plain.contains(languageKey(li.getLocale()))) {
+                mItems.add(li);
+            }
+        }
+        Collator collator = Collator.getInstance();
+        mItems.sort((a, b) -> collator.compare(a.getFullNameNative(), b.getFullNameNative()));
+
+        String current = Locale.getDefault().getLanguage();
+        for (int i = 0; i < mItems.size(); i++) {
+            LocaleStore.LocaleInfo li = mItems.get(i);
+            String inUi = li.getFullNameInUiLanguage();
+            actions.add(choice(i, li.getFullNameNative(),
+                    inUi.equals(li.getFullNameNative()) ? null : inUi));
+            if (li.getLocale().getLanguage().equals(current)) {
+                mInitialSelection = i;
+            }
+        }
+    }
+
+    private static String languageKey(Locale locale) {
+        return locale.getLanguage() + "-" + locale.getScript();
+    }
+
+    @Override
+    public void onGuidedActionClicked(GuidedAction action) {
+        LocaleStore.LocaleInfo language = mItems.get((int) action.getId());
+        SetupActivity setup = setup();
+        setup.language = language;
+
+        Set<LocaleStore.LocaleInfo> regions =
+                LocaleStore.getLevelLocales(requireContext(), new HashSet<>(), language, true);
+        if (regions.size() > 1) {
+            next(new RegionStep());
+            return;
+        }
+        setup.locale = regions.isEmpty()
+                ? language.getLocale() : regions.iterator().next().getLocale();
+        next(new CountryStep());
+    }
+}
