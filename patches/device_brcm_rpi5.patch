+/*
+ * SPDX-License-Identifier: Apache-2.0
+ *
+ * Raspberry Pi firmware helpers for A/B booting: the one-shot tryboot flag (VideoCore
+ * mailbox through /dev/vcio) and what the bootloader reports in /proc/device-tree.
+ */
+
+#pragma once
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* Sets (1) or clears (0) the tryboot flag for the next reboot. Returns 0 or -errno. */
+int rpi_set_tryboot(int enable);
+
+/* Current tryboot flag for the next reboot (0/1), or -errno. */
+int rpi_get_tryboot(void);
+
+/* Partition number the firmware booted from, or -errno. */
+int rpi_booted_partition(void);
+
+/* 1 if this boot is a tryboot, 0 if not, or -errno. */
+int rpi_booted_tryboot(void);
+
+#ifdef __cplusplus
+}
+#endif
diff --git a/boot_control/rpi_tryboot.c b/boot_control/rpi_tryboot.c
new file mode 100644
index 0000000..b10898f
--- /dev/null
+++ b/boot_control/rpi_tryboot.c
@@ -0,0 +1,29 @@
+/*
+ * SPDX-License-Identifier: Apache-2.0
+ *
+ * Debug tool: rpi_tryboot [status|set|clear]
+ */
+
+#include <stdio.h>
+#include <string.h>
+
+#include "autoboot.h"
+#include "rpi_firmware.h"
+
+int main(int argc, char **argv) {
+    const char *cmd = argc > 1 ? argv[1] : "status";
+    if (!strcmp(cmd, "set") || !strcmp(cmd, "clear")) {
+        int r = rpi_set_tryboot(!strcmp(cmd, "set"));
+        if (r < 0) {
+            fprintf(stderr, "rpi_tryboot: %s failed: %s\n", cmd, strerror(-r));
+            return 1;
+        }
+    } else if (strcmp(cmd, "status")) {
+        fprintf(stderr, "usage: rpi_tryboot [status|set|clear]\n");
+        return 2;
+    }
+    printf("booted_partition=%d booted_tryboot=%d next_tryboot=%d autoboot_default=%d\n",
+           rpi_booted_partition(), rpi_booted_tryboot(), rpi_get_tryboot(),
+           autoboot_read_all_partition("/dev/block/by-name/bootsel"));
+    return 0;
+}
