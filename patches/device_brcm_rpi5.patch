@@ -0,0 +1,53 @@
+/*
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package tv.ladrok.updater;
+
+import org.json.JSONArray;
+import org.json.JSONException;
+import org.json.JSONObject;
+
+/** One release's update.json, written by scripts/make-ota.sh, plus where to download it. */
+final class UpdateConfig {
+    final String json;
+    final String url;
+
+    final String version;
+    final String fingerprint;
+    /** Fingerprint an incremental package applies to; null for a full package. */
+    final String incrementalFrom;
+    final long timestamp;
+    final String file;
+    final long size;
+    final String sha256;
+    final long payloadOffset;
+    final long payloadSize;
+    final String[] payloadProperties;
+    /** SD-card partition layout the update was built for (1 = the original 3 GB layout). */
+    final int layout;
+
+    UpdateConfig(String json, String url) throws JSONException {
+        this.json = json;
+        this.url = url;
+        JSONObject o = new JSONObject(json);
+        version = o.getString("version");
+        fingerprint = o.optString("fingerprint", "");
+        incrementalFrom = o.isNull("incremental_from") ? null : o.optString("incremental_from", null);
+        timestamp = o.getLong("timestamp");
+        file = o.getString("file");
+        size = o.getLong("size");
+        sha256 = o.getString("sha256");
+        payloadOffset = o.getLong("payload_offset");
+        payloadSize = o.getLong("payload_size");
+        layout = o.optInt("layout", 1);
+        JSONArray props = o.getJSONArray("payload_properties");
+        payloadProperties = new String[props.length()];
+        for (int i = 0; i < props.length(); i++) {
+            payloadProperties[i] = props.getString(i);
+        }
+        if (file.contains("/") || file.startsWith(".")) {
+            throw new JSONException("bad file name " + file);
+        }
+    }
+}
diff --git a/LadrokUpdater/src/tv/ladrok/updater/UpdateService.java b/LadrokUpdater/src/tv/ladrok/updater/UpdateService.java
new file mode 100644
index 0000000..882b743
--- /dev/null
+++ b/LadrokUpdater/src/tv/ladrok/updater/UpdateService.java
@@ -0,0 +1,221 @@
+/*
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package tv.ladrok.updater;
+
+import android.app.Notification;
+import android.app.NotificationChannel;
+import android.app.NotificationManager;
+import android.app.PendingIntent;
+import android.app.Service;
+import android.content.Context;
+import android.content.Intent;
+import android.content.pm.ServiceInfo;
+import android.os.Handler;
+import android.os.HandlerThread;
+import android.os.IBinder;
+import android.os.Looper;
+import android.os.PowerManager;
+import android.os.UpdateEngine;
+import android.os.UpdateEngineCallback;
+import android.util.Log;
+import android.widget.Toast;
+
+import java.io.File;
+import java.io.IOException;
+import java.util.concurrent.CountDownLatch;
+import java.util.concurrent.ExecutorService;
+import java.util.concurrent.Executors;
+
+/** Runs the long operations (check + download, install) in the foreground, one at a time. */
+public class UpdateService extends Service {
+    /** Check for a newer release and download it; the user is asked before installing. */
+    static final String ACTION_CHECK = "tv.ladrok.updater.CHECK";
+    static final String ACTION_INSTALL = "tv.ladrok.updater.INSTALL";
+    static final String ACTION_REBOOT = "tv.ladrok.updater.REBOOT";
+
+    private static final String CHANNEL = "updates";
+    private static final int NOTIF_WORK = 1;
+    private static final int NOTIF_PROMPT = 2;
+
+    private final ExecutorService mExecutor = Executors.newSingleThreadExecutor();
+    private final Handler mMain = new Handler(Looper.getMainLooper());
+    private int mPending;
+    private Updater mUpdater;
+    private NotificationManager mNotifications;
+
+    static void start(Context context, String action) {
+        context.startForegroundService(new Intent(context, UpdateService.class).setAction(action));
+    }
+
+    @Override
+    public void onCreate() {
+        super.onCreate();
+        mUpdater = Updater.get(this);
+        mNotifications = getSystemService(NotificationManager.class);
+        mNotifications.createNotificationChannel(new NotificationChannel(
+                CHANNEL, getString(R.string.channel_name), NotificationManager.IMPORTANCE_DEFAULT));
+    }
+
+    @Override
+    public int onStartCommand(Intent intent, int flags, int startId) {
+        startForeground(NOTIF_WORK, work(getString(R.string.app_name), -1),
+                ServiceInfo.FOREGROUND_SERVICE_TYPE_DATA_SYNC);
+        String action = intent != null ? intent.getAction() : null;
+        Runnable task;
+        if (ACTION_INSTALL.equals(action)) {
+            task = this::install;
+        } else if (ACTION_REBOOT.equals(action)) {
+            task = () -> getSystemService(PowerManager.class).reboot(null);
+        } else {
+            task = this::check;
+        }
+        mPending++;
+        mExecutor.execute(() -> {
+            try {
+                task.run();
+            } catch (RuntimeException e) {
+                Log.e(Updater.TAG, "task failed", e);
+                mUpdater.setError(String.valueOf(e.getMessage()));
+            } finally {
+                mMain.post(this::taskDone);
+            }
+        });
+        return START_NOT_STICKY;
+    }
+
+    private void taskDone() {
+        if (--mPending == 0) {
+            stopForeground(STOP_FOREGROUND_REMOVE);
+            stopSelf();
+        }
+    }
+
+    @Override
+    public IBinder onBind(Intent intent) {
+        return null;
+    }
+
+    private void check() {
+        Updater.State s = mUpdater.state();
+        if (s == Updater.State.INSTALLING || s == Updater.State.NEED_REBOOT) return;
+        // The launcher has its own releases; a failure there doesn't touch the system update state
+        try {
+            new LauncherUpdate(this).run();
+        } catch (IOException | RuntimeException e) {
+            Log.w(Updater.TAG, "launcher update: " + e.getMessage());
+        }
+        mUpdater.setState(Updater.State.CHECKING);
+        try {
+            UpdateConfig c = mUpdater.fetchLatest();
+            if (c == null) {
+                mUpdater.setState(Updater.State.UP_TO_DATE);
+                return;
+            }
+            UpdateConfig old = mUpdater.config();
+            if (old == null || !old.file.equals(c.file)) mUpdater.deletePackages();
+            mUpdater.setConfig(c);
+            mUpdater.setState(Updater.State.DOWNLOADING);
+            String title = getString(R.string.notify_downloading, c.version);
+            mUpdater.download(c, percent -> {
+                mUpdater.setProgress(percent);
+                mNotifications.notify(NOTIF_WORK, work(title, percent));
+            });
+            mUpdater.setState(Updater.State.READY);
+            prompt(getString(R.string.notify_ready, c.version));
+        } catch (IOException e) {
+            mUpdater.setError(e.getMessage());
+        }
+    }
+
+    private void install() {
+        UpdateConfig c = mUpdater.config();
+        if (c == null) return;
+        File f = mUpdater.packageFile(c);
+        if (!f.isFile() || f.length() != c.size) {
+            mUpdater.setError("the update package is missing; check for updates again");
+            return;
+        }
+        mUpdater.setState(Updater.State.INSTALLING);
+        mNotifications.cancel(NOTIF_PROMPT);
+
+        HandlerThread thread = new HandlerThread("update_engine");
+        thread.start();
+        CountDownLatch done = new CountDownLatch(1);
+        int[] result = {-1};
+        UpdateEngine engine = new UpdateEngine();
+        String title = getString(R.string.notify_installing, c.version);
+        engine.bind(new UpdateEngineCallback() {
+            @Override
+            public void onStatusUpdate(int status, float percent) {
+                if (status == UpdateEngine.UpdateStatusConstants.DOWNLOADING
+                        || status == UpdateEngine.UpdateStatusConstants.VERIFYING
+                        || status == UpdateEngine.UpdateStatusConstants.FINALIZING) {
+                    int p = (int) (percent * 100);
+                    if (p != mUpdater.progress()) {
+                        mUpdater.setProgress(p);
+                        mNotifications.notify(NOTIF_WORK, work(title, p));
+                    }
+                }
+            }
+
+            @Override
+            public void onPayloadApplicationComplete(int errorCode) {
+                result[0] = errorCode;
+                done.countDown();
+            }
+        }, new Handler(thread.getLooper()));
+        try {
+            engine.resetStatus();
+            engine.applyPayload("file://" + f.getAbsolutePath(), c.payloadOffset, c.payloadSize,
+                    c.payloadProperties);
+            done.await();
+        } catch (RuntimeException e) {
+            mUpdater.setError("update_engine refused the update: " + e.getMessage());
+            return;
+        } catch (InterruptedException e) {
+            Thread.currentThread().interrupt();
+            return;
+        } finally {
+            engine.unbind();
+            thread.quitSafely();
+        }
+        if (result[0] == UpdateEngine.ErrorCodeConstants.SUCCESS) {
+            mUpdater.setState(Updater.State.NEED_REBOOT);
+            prompt(getString(R.string.notify_reboot, c.version));
+        } else {
+            mUpdater.setError("update_engine error " + result[0]);
+        }
+    }
+
+    private Notification work(String title, int percent) {
+        Notification.Builder b = new Notification.Builder(this, CHANNEL)
+                .setSmallIcon(R.drawable.ic_update)
+                .setContentTitle(title)
+                .setContentIntent(openActivity())
+                .setOngoing(true)
+                .setOnlyAlertOnce(true);
+        if (percent >= 0) b.setProgress(100, percent, false);
+        return b.build();
+    }
+
+    /** Asks the user to open the app: a notification, plus a toast because a TV home screen
+     * may not show notifications. */
+    private void prompt(String title) {
+        mNotifications.notify(NOTIF_PROMPT, new Notification.Builder(this, CHANNEL)
+                .setSmallIcon(R.drawable.ic_update)
+                .setContentTitle(title)
+                .setContentText(getString(R.string.notify_open))
+                .setContentIntent(openActivity())
+                .setAutoCancel(true)
+                .build());
+        mMain.post(() -> Toast.makeText(this, title + "\n" + getString(R.string.notify_open),
+                Toast.LENGTH_LONG).show());
+    }
+
+    private PendingIntent openActivity() {
+        return PendingIntent.getActivity(this, 0, new Intent(this, UpdateActivity.class),
+                PendingIntent.FLAG_IMMUTABLE);
+    }
+}
diff --git a/LadrokUpdater/src/tv/ladrok/updater/Updater.java b/LadrokUpdater/src/tv/ladrok/updater/Updater.java
new file mode 100644
index 0000000..e28fa75
--- /dev/null
+++ b/LadrokUpdater/src/tv/ladrok/updater/Updater.java
@@ -0,0 +1,284 @@
+/*
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package tv.ladrok.updater;
+
+import android.content.Context;
+import android.content.SharedPreferences;
+import android.os.Build;
+import android.text.TextUtils;
+import android.util.Log;
+
+import org.json.JSONArray;
+import org.json.JSONException;
+import org.json.JSONObject;
+
+import java.io.ByteArrayOutputStream;
+import java.io.File;
+import java.io.FileInputStream;
+import java.io.FileOutputStream;
+import java.io.IOException;
+import java.io.InputStream;
+import java.io.OutputStream;
+import java.net.HttpURLConnection;
+import java.net.URL;
+import java.nio.charset.StandardCharsets;
+import java.security.MessageDigest;
+import java.security.NoSuchAlgorithmException;
+
+/**
+ * Update state (persisted, shared by the service, the activity and the boot receiver) and
+ * the network side: finding the latest release and downloading its package.
+ */
+final class Updater {
+    static final String TAG = "LadrokUpdater";
+
+    enum State {
+        IDLE, CHECKING, UP_TO_DATE, DOWNLOADING, READY, INSTALLING, NEED_REBOOT, UPDATED, ERROR
+    }
+
+    /** update_engine may read payloads from here (system:cache, ota_package_file). */
+    static final File PACKAGE_DIR = new File("/data/ota_package");
+
+    static final String API = "https://api.github.com/repos/%s/releases/latest";
+    /** Each release carries one update config per build variant: update-user.json, ... */
+    private static final String CONFIG_ASSET = "update-" + Build.TYPE + ".json";
+
+    private static Updater sInstance;
+
+    private final Context mContext;
+    private final SharedPreferences mPrefs;
+
+    static synchronized Updater get(Context context) {
+        if (sInstance == null) sInstance = new Updater(context.getApplicationContext());
+        return sInstance;
+    }
+
+    private Updater(Context context) {
+        mContext = context;
+        mPrefs = context.getSharedPreferences("updater", Context.MODE_PRIVATE);
+    }
+
+    // ---- state ----
+
+    synchronized State state() {
+        try {
+            return State.valueOf(mPrefs.getString("state", State.IDLE.name()));
+        } catch (IllegalArgumentException e) {
+            return State.IDLE;
+        }
+    }
+
+    synchronized int progress() {
+        return mPrefs.getInt("progress", 0);
+    }
+
+    synchronized String error() {
+        return mPrefs.getString("error", "");
+    }
+
+    synchronized void setState(State state) {
+        mPrefs.edit().putString("state", state.name()).putInt("progress", 0).apply();
+        Log.i(TAG, "state " + state);
+    }
+
+    synchronized void setProgress(int percent) {
+        mPrefs.edit().putInt("progress", percent).apply();
+    }
+
+    synchronized void setError(String message) {
+        mPrefs.edit().putString("state", State.ERROR.name()).putString("error", message).apply();
+        Log.e(TAG, "error: " + message);
+    }
+
+    /** The release being downloaded/installed, or null. */
+    synchronized UpdateConfig config() {
+        String json = mPrefs.getString("config", null);
+        if (json == null) return null;
+        try {
+            return new UpdateConfig(json, mPrefs.getString("config_url", ""));
+        } catch (JSONException e) {
+            return null;
+        }
+    }
+
+    synchronized void setConfig(UpdateConfig config) {
+        mPrefs.edit()
+                .putString("config", config == null ? null : config.json)
+                .putString("config_url", config == null ? null : config.url)
+                .apply();
+    }
+
+    File packageFile(UpdateConfig config) {
+        return new File(PACKAGE_DIR, config.file);
+    }
+
+    /** Removes downloaded packages (all of them: only one update is handled at a time). */
+    void deletePackages() {
+        File[] files = PACKAGE_DIR.listFiles();
+        if (files == null) return;
+        for (File f : files) {
+            if (f.getName().startsWith("ladrok-tv-ota-") && !f.delete()) {
+                Log.w(TAG, "cannot delete " + f);
+            }
+        }
+    }
+
+    // ---- network ----
+
+    /** Latest release's update config, or null if it isn't newer than this build. */
+    UpdateConfig fetchLatest() throws IOException {
+        String repo = mContext.getString(R.string.release_repo);
+        if (TextUtils.isEmpty(repo)) throw new IOException(mContext.getString(R.string.no_repo));
+        try {
+            JSONObject release = new JSONObject(fetchString(String.format(API, repo)));
+            JSONArray assets = release.getJSONArray("assets");
+            String configUrl = null;
+            for (int i = 0; i < assets.length(); i++) {
+                JSONObject a = assets.getJSONObject(i);
+                if (CONFIG_ASSET.equals(a.getString("name"))) {
+                    configUrl = a.getString("browser_download_url");
+                }
+            }
+            if (configUrl == null) {
+                throw new IOException("release " + release.optString("tag_name") + " has no "
+                        + CONFIG_ASSET);
+            }
+            String json = fetchString(configUrl);
+            UpdateConfig probe = new UpdateConfig(json, "");
+            int layout = mContext.getResources().getInteger(R.integer.layout_version);
+            if (probe.layout != layout && probe.timestamp > Build.TIME / 1000) {
+                // Partition sizes differ: update_engine can't write it. Only a fresh card works.
+                throw new IOException(mContext.getString(R.string.needs_reflash, probe.version));
+            }
+            for (int i = 0; i < assets.length(); i++) {
+                JSONObject a = assets.getJSONObject(i);
+                if (probe.file.equals(a.getString("name"))) {
+                    UpdateConfig config = new UpdateConfig(json, a.getString("browser_download_url"));
+                    return isApplicable(config) ? config : null;
+                }
+            }
+            throw new IOException("release has no " + probe.file);
+        } catch (JSONException e) {
+            throw new IOException("bad release data: " + e.getMessage(), e);
+        }
+    }
+
+    /** Newer than this build, for this device, and (if incremental) based on this build. */
+    static boolean isApplicable(UpdateConfig c) {
+        String device = Build.BRAND + "/" + Build.PRODUCT + "/" + Build.DEVICE + ":";
+        if (!c.fingerprint.startsWith(device)) {
+            Log.i(TAG, "update is for another device: " + c.fingerprint);
+            return false;
+        }
+        if (c.incrementalFrom != null && !c.incrementalFrom.equals(Build.FINGERPRINT)) {
+            Log.i(TAG, "incremental update for another build: " + c.incrementalFrom);
+            return false;
+        }
+        return c.timestamp > Build.TIME / 1000;
+    }
+
+    interface ProgressListener {
+        void onProgress(int percent);
+    }
+
+    /** Downloads (resuming a partial file) and checks the SHA-256. */
+    void download(UpdateConfig c, ProgressListener listener) throws IOException {
+        File f = packageFile(c);
+        long have = f.exists() ? f.length() : 0;
+        if (have > c.size) {
+            f.delete();
+            have = 0;
+        }
+        if (have < c.size) {
+            HttpURLConnection conn = open(c.url);
+            if (have > 0) conn.setRequestProperty("Range", "bytes=" + have + "-");
+            int code = conn.getResponseCode();
+            boolean append = have > 0 && code == HttpURLConnection.HTTP_PARTIAL;
+            if (code != HttpURLConnection.HTTP_OK && !append) {
+                throw new IOException("download failed: HTTP " + code);
+            }
+            if (!append) have = 0;
+            try (InputStream in = conn.getInputStream();
+                 OutputStream out = new FileOutputStream(f, append)) {
+                byte[] buf = new byte[1 << 16];
+                int n, lastPercent = -1;
+                while ((n = in.read(buf)) > 0) {
+                    out.write(buf, 0, n);
+                    have += n;
+                    int percent = (int) (have * 100 / c.size);
+                    if (percent != lastPercent) {
+                        listener.onProgress(percent);
+                        lastPercent = percent;
+                    }
+                }
+            } finally {
+                conn.disconnect();
+            }
+        }
+        if (f.length() != c.size || !c.sha256.equalsIgnoreCase(sha256(f))) {
+            f.delete();
+            throw new IOException("downloaded file is corrupt (size or SHA-256 mismatch)");
+        }
+        // update_engine runs as root but in its own SELinux domain; make the file readable.
+        f.setReadable(true, false);
+    }
+
+    private static String sha256(File f) throws IOException {
+        try (InputStream in = new FileInputStream(f)) {
+            MessageDigest md = MessageDigest.getInstance("SHA-256");
+            byte[] buf = new byte[1 << 16];
+            int n;
+            while ((n = in.read(buf)) > 0) md.update(buf, 0, n);
+            StringBuilder sb = new StringBuilder();
+            for (byte b : md.digest()) sb.append(String.format("%02x", b));
+            return sb.toString();
+        } catch (NoSuchAlgorithmException e) {
+            throw new IOException(e);
+        }
+    }
+
+    private static HttpURLConnection open(String url) throws IOException {
+        HttpURLConnection conn = (HttpURLConnection) new URL(url).openConnection();
+        conn.setConnectTimeout(30_000);
+        conn.setReadTimeout(60_000);
+        conn.setRequestProperty("User-Agent", "LadrokUpdater");
+        conn.setRequestProperty("Accept", "application/vnd.github+json, application/octet-stream");
+        conn.setInstanceFollowRedirects(true);
+        return conn;
+    }
+
+    /** Downloads a (small) file in one go, replacing f. */
+    static void downloadTo(String url, File f) throws IOException {
+        HttpURLConnection conn = open(url);
+        try {
+            int code = conn.getResponseCode();
+            if (code != HttpURLConnection.HTTP_OK) throw new IOException("HTTP " + code + " for " + url);
+            try (InputStream in = conn.getInputStream(); OutputStream out = new FileOutputStream(f)) {
+                byte[] buf = new byte[1 << 16];
+                int n;
+                while ((n = in.read(buf)) > 0) out.write(buf, 0, n);
+            }
+        } finally {
+            conn.disconnect();
+        }
+    }
+
+    static String fetchString(String url) throws IOException {
+        HttpURLConnection conn = open(url);
+        try {
+            int code = conn.getResponseCode();
+            if (code != HttpURLConnection.HTTP_OK) throw new IOException("HTTP " + code + " for " + url);
+            try (InputStream in = conn.getInputStream()) {
+                ByteArrayOutputStream out = new ByteArrayOutputStream();
+                byte[] buf = new byte[8192];
+                int n;
+                while ((n = in.read(buf)) > 0) out.write(buf, 0, n);
+                return out.toString(StandardCharsets.UTF_8);
+            }
+        } finally {
+            conn.disconnect();
+        }
+    }
+}
