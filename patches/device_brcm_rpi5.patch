diff --git a/boot_control/autoboot.c b/boot_control/autoboot.c
new file mode 100644
index 0000000..275c146
--- /dev/null
+++ b/boot_control/autoboot.c
@@ -0,0 +1,120 @@
+/*
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+#include "autoboot.h"
+
+#include <errno.h>
+#include <fcntl.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+
+static uint16_t le16(const uint8_t *p) { return p[0] | p[1] << 8; }
+static uint32_t le32(const uint8_t *p) { return le16(p) | (uint32_t)le16(p + 2) << 16; }
+
+static int read_at(int fd, void *buf, size_t len, off_t off) {
+    ssize_t n = pread(fd, buf, len, off);
+    if (n < 0) return -errno;
+    return n == (ssize_t)len ? 0 : -EIO;
+}
+
+/* Byte offset of autoboot.txt's data on a FAT12/16/32 volume, or -errno. */
+static off_t locate(int fd) {
+    uint8_t bs[512];
+    int r = read_at(fd, bs, sizeof(bs), 0);
+    if (r < 0) return r;
+    if (bs[510] != 0x55 || bs[511] != 0xaa) return -EINVAL;
+
+    uint32_t bps = le16(bs + 11), spc = bs[13], rsvd = le16(bs + 14), nfats = bs[16];
+    uint32_t root_entries = le16(bs + 17);
+    uint32_t fatsz = le16(bs + 22) ? le16(bs + 22) : le32(bs + 36);
+    if (bps < 512 || bps > 4096 || !spc || !nfats || !fatsz) return -EINVAL;
+
+    uint32_t root_sectors = (root_entries * 32 + bps - 1) / bps;
+    uint32_t first_data = rsvd + nfats * fatsz + root_sectors;
+
+    /* FAT12/16 have a fixed root directory; FAT32 keeps it in a cluster (we read the first). */
+    uint32_t dir_sector, dir_bytes;
+    if (root_entries) {
+        dir_sector = rsvd + nfats * fatsz;
+        dir_bytes = root_sectors * bps;
+    } else {
+        dir_sector = first_data + (le32(bs + 44) - 2) * spc;
+        dir_bytes = spc * bps;
+    }
+
+    uint8_t *dir = malloc(dir_bytes);
+    if (!dir) return -ENOMEM;
+    r = read_at(fd, dir, dir_bytes, (off_t)dir_sector * bps);
+    off_t result = r < 0 ? r : -ENOENT;
+    for (uint32_t i = 0; r == 0 && i + 32 <= dir_bytes; i += 32) {
+        const uint8_t *e = dir + i;
+        if (e[0] == 0) break;                          /* end of directory */
+        if (e[0] == 0xe5 || e[11] == 0x0f) continue;   /* deleted, long-name part */
+        if (memcmp(e, "AUTOBOOTTXT", 11)) continue;
+        uint32_t cluster = (uint32_t)le16(e + 20) << 16 | le16(e + 26);
+        if (le32(e + 28) != AUTOBOOT_SIZE || cluster < 2) {
+            result = -EFBIG;  /* not the fixed-size file the image build creates */
+        } else {
+            result = (off_t)(first_data + (cluster - 2) * spc) * bps;
+        }
+        break;
+    }
+    free(dir);
+    return result;
+}
+
+int autoboot_write(const char *dev, int all_part, int tryboot_part) {
+    char buf[AUTOBOOT_SIZE];
+    int len = snprintf(buf, sizeof(buf),
+                       "# Written by the boot control HAL (android.hardware.boot-service.rpi).\n"
+                       "# Must stay exactly %d bytes: it is rewritten in place.\n"
+                       "[all]\n"
+                       "tryboot_a_b=1\n"
+                       "boot_partition=%d\n"
+                       "[tryboot]\n"
+                       "boot_partition=%d\n",
+                       AUTOBOOT_SIZE, all_part, tryboot_part);
+    if (len < 0 || len >= (int)sizeof(buf) - 2) return -EINVAL;
+    /* Pad with one comment line so the size stays fixed. */
+    memset(buf + len, ' ', sizeof(buf) - len);
+    buf[len] = '#';
+    buf[sizeof(buf) - 1] = '\n';
+
+    int fd = open(dev, O_RDWR | O_SYNC | O_CLOEXEC);
+    if (fd < 0) return -errno;
+    off_t off = locate(fd);
+    int r = off < 0 ? (int)off : 0;
+    if (r == 0) {
+        ssize_t n = pwrite(fd, buf, sizeof(buf), off);
+        r = n < 0 ? -errno : n != (ssize_t)sizeof(buf) ? -EIO : 0;
+    }
+    if (r == 0 && fsync(fd) < 0) r = -errno;
+    if (r == 0) {
+        char check[AUTOBOOT_SIZE];
+        r = read_at(fd, check, sizeof(check), off);
+        if (r == 0 && memcmp(buf, check, sizeof(buf))) r = -EIO;
+    }
+    close(fd);
+    return r;
+}
+
+int autoboot_read_all_partition(const char *dev) {
+    char buf[AUTOBOOT_SIZE + 1];
+    int fd = open(dev, O_RDONLY | O_CLOEXEC);
+    if (fd < 0) return -errno;
+    off_t off = locate(fd);
+    int r = off < 0 ? (int)off : read_at(fd, buf, AUTOBOOT_SIZE, off);
+    close(fd);
+    if (r < 0) return r;
+    buf[AUTOBOOT_SIZE] = '\0';
+
+    const char *all = strstr(buf, "[all]");
+    const char *p = all ? strstr(all, "boot_partition=") : NULL;
+    const char *next_section = all ? strchr(all + 1, '[') : NULL;
+    if (!p || (next_section && p > next_section)) return -ENOENT;
+    return atoi(p + strlen("boot_partition="));
+}
diff --git a/boot_control/autoboot.h b/boot_control/autoboot.h
new file mode 100644
index 0000000..4b93d79
--- /dev/null
+++ b/boot_control/autoboot.h
@@ -0,0 +1,29 @@
+/*
+ * SPDX-License-Identifier: Apache-2.0
+ *
+ * In-place rewrite of autoboot.txt on the small FAT "bootsel" partition that the Pi
+ * firmware reads first. The file is created at image build time with a fixed size of
+ * AUTOBOOT_SIZE bytes in one cluster; we only ever overwrite that one sector, so the FAT,
+ * the directory entry and the file size never change and a power cut can't corrupt them.
+ */
+
+#pragma once
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#define AUTOBOOT_SIZE 512
+
+/*
+ * Writes autoboot.txt: normal boots use partition `all_part`, tryboots `tryboot_part`.
+ * `dev` is the bootsel block device. Returns 0 or -errno.
+ */
+int autoboot_write(const char *dev, int all_part, int tryboot_part);
+
+/* Reads the [all] boot_partition from autoboot.txt, or -errno. */
+int autoboot_read_all_partition(const char *dev);
+
+#ifdef __cplusplus
+}
+#endif
