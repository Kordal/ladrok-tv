diff --git a/device.mk b/device.mk
index 0660912..8b6d97e 100644
--- a/device.mk
+++ b/device.mk
@@ -188,3 +188,29 @@ PRODUCT_PACKAGES += \
 
 PRODUCT_COPY_FILES += \
     frameworks/native/data/etc/android.hardware.wifi.xml:$(TARGET_COPY_OUT_VENDOR)/etc/permissions/android.hardware.wifi.xml
+
+# Grow userdata to the full SD card on first boot
+PRODUCT_PACKAGES += \
+    rpi_resize_data
+
+# System-owned properties that vendor_init may not set from vendor.prop (SELinux refuses
+# them there): bluetooth_prop, default_prop, device_config_mglru_native_prop.
+PRODUCT_PRODUCT_PROPERTIES += \
+    persist.bluetooth.a2dp_aac.vbr_supported=true \
+    ro.lockscreen.disable.default=true \
+    persist.device_config.mglru_native.lru_gen_config=core
+
+# A/B updates: boot control through the Pi firmware's autoboot.txt + tryboot
+PRODUCT_PACKAGES += \
+    android.hardware.boot-service.rpi \
+    rpi_tryboot \
+    update_engine \
+    update_engine_client \
+    update_verifier
+
+# OTA payloads must be signed with this key's private half (kept outside the source tree,
+# see scripts/make-ota.sh); update_engine refuses anything else. otacerts_ladrok replaces the
+# stock otacerts.zip, which would also trust the public AOSP test key.
+PRODUCT_OTA_PUBLIC_KEYS := $(DEVICE_PATH)/security/ota.x509.pem
+PRODUCT_PACKAGES += \
+    otacerts_ladrok
diff --git a/mkbootimg.mk b/mkbootimg.mk
index 78ea22f..c7ee821 100644
--- a/mkbootimg.mk
+++ b/mkbootimg.mk
@@ -7,8 +7,11 @@
 DEVICE_PATH := device/brcm/rpi5
 KERNEL_PATH := device/brcm/rpi5-kernel
 
+# One FAT image serves both A/B slots: config.txt picks cmdline_a.txt or cmdline_b.txt by
+# the partition the firmware booted from, which gives androidboot.slot_suffix.
 RPI_BOOT_OUT := $(PRODUCT_OUT)/rpiboot
-$(RPI_BOOT_OUT): $(INSTALLED_RAMDISK_TARGET)
+$(RPI_BOOT_OUT): $(INSTALLED_RAMDISK_TARGET) $(DEVICE_PATH)/boot/config.txt $(DEVICE_PATH)/mkbootimg.mk
+	rm -rf $(RPI_BOOT_OUT)
 	mkdir -p $(RPI_BOOT_OUT)
 	mkdir -p $(RPI_BOOT_OUT)/overlays
 	cp $(DEVICE_PATH)/boot/* $(RPI_BOOT_OUT)
@@ -16,10 +19,19 @@ $(RPI_BOOT_OUT): $(INSTALLED_RAMDISK_TARGET)
 	cp $(KERNEL_PATH)/bcm2712*-rpi-*.dtb $(RPI_BOOT_OUT)
 	cp $(KERNEL_PATH)/overlays/* $(RPI_BOOT_OUT)/overlays
 	cp $(PRODUCT_OUT)/ramdisk.img $(RPI_BOOT_OUT)
-	echo $(BOARD_KERNEL_CMDLINE) > $(RPI_BOOT_OUT)/cmdline.txt
+	echo $(BOARD_KERNEL_CMDLINE) androidboot.slot_suffix=_a > $(RPI_BOOT_OUT)/cmdline.txt
+	echo $(BOARD_KERNEL_CMDLINE) androidboot.slot_suffix=_a > $(RPI_BOOT_OUT)/cmdline_a.txt
+	echo $(BOARD_KERNEL_CMDLINE) androidboot.slot_suffix=_b > $(RPI_BOOT_OUT)/cmdline_b.txt
 
 $(INSTALLED_BOOTIMAGE_TARGET): $(RPI_BOOT_OUT)
 	$(call pretty,"Target boot image: $@")
 	dd if=/dev/zero of=$@ bs=1M count=128
 	mkfs.fat -F 32 -n "boot" $@
 	mcopy -s -i $@ $(RPI_BOOT_OUT)/* ::
+
+# The A/B partition image (same content); radio images go into the target files' RADIO/
+# and from there into the OTA payload.
+INSTALLED_RPIBOOTIMAGE_TARGET := $(PRODUCT_OUT)/rpiboot.img
+$(INSTALLED_RPIBOOTIMAGE_TARGET): $(INSTALLED_BOOTIMAGE_TARGET)
+	cp $< $@
+INSTALLED_RADIOIMAGE_TARGET += $(INSTALLED_RPIBOOTIMAGE_TARGET)
