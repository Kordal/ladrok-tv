diff --git a/sepolicy/rpi_resize_data.te b/sepolicy/rpi_resize_data.te
new file mode 100644
index 0000000..c0aac20
--- /dev/null
+++ b/sepolicy/rpi_resize_data.te
@@ -0,0 +1,21 @@
+# rpi_resize_data: grows the userdata partition to the end of the card (partition table on
+# the whole disk + BLKPG) and then the mounted ext4 (EXT4_IOC_RESIZE_FS on /data/vendor).
+type rpi_resize_data, domain;
+type rpi_resize_data_exec, exec_type, vendor_file_type, file_type;
+
+init_daemon_domain(rpi_resize_data)
+
+# stdio_to_kmsg (/dev/kmsg_debug on userdebug builds)
+allow rpi_resize_data { kmsg_device kmsg_debug_device }:chr_file { getattr w_file_perms };
+
+# ext4 online resize may use the reserved blocks
+allow rpi_resize_data self:capability sys_resource;
+
+# Partition table: whole-disk read/write, size query, in-place partition resize
+allow rpi_resize_data block_device:dir search;
+allow rpi_resize_data rpi_disk_block_device:blk_file rw_file_perms;
+allowxperm rpi_resize_data rpi_disk_block_device:blk_file ioctl { BLKGETSIZE64 BLKPG };
+
+# Online filesystem resize through any directory on /data (EXT4_IOC_RESIZE_FS = _IOW('f', 16, u64))
+allow rpi_resize_data vendor_data_file:dir r_dir_perms;
+allowxperm rpi_resize_data vendor_data_file:dir ioctl 0x6610;
