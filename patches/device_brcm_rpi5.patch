diff --git a/LadrokUpdater/src/tv/ladrok/updater/BootReceiver.java b/LadrokUpdater/src/tv/ladrok/updater/BootReceiver.java
new file mode 100644
index 0000000..1e5411f
--- /dev/null
+++ b/LadrokUpdater/src/tv/ladrok/updater/BootReceiver.java
@@ -0,0 +1,39 @@
+/*
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package tv.ladrok.updater;
+
+import android.content.BroadcastReceiver;
+import android.content.Context;
+import android.content.Intent;
+import android.os.Build;
+
+/** Schedules the daily check, and settles the state after the reboot into an update. */
+public class BootReceiver extends BroadcastReceiver {
+    @Override
+    public void onReceive(Context context, Intent intent) {
+        if (!Intent.ACTION_BOOT_COMPLETED.equals(intent.getAction())) return;
+        DailyCheckJob.schedule(context);
+
+        Updater u = Updater.get(context);
+        UpdateConfig c = u.config();
+        switch (u.state()) {
+            case INSTALLING:
+                // Interrupted by a reboot; the package is still there, so it can be retried.
+                u.setState(Updater.State.READY);
+                break;
+            case NEED_REBOOT:
+                if (c != null && Build.TIME / 1000 >= c.timestamp) {
+                    u.setState(Updater.State.UPDATED);
+                } else {
+                    // The firmware fell back to the old slot: the new one didn't boot.
+                    u.setError(context.getString(R.string.state_rolled_back));
+                }
+                u.deletePackages();
+                break;
+            default:
+                break;
+        }
+    }
+}
