+<?xml version="1.0" encoding="utf-8"?>
+<!-- SPDX-License-Identifier: Apache-2.0 -->
+<resources>
+    <!-- SD-card partition layout this system was built for (scripts/mkimg-ab.sh). OTAs carry
+         theirs in update-<variant>.json ("layout"); a different one needs a fresh card image.
+         1 = system 3 GB / vendor 384 MB per slot, 2 = system 6 GB / vendor 1 GB per slot.
+         scripts/make-ota.sh reads the value from this file. -->
+    <integer name="layout_version">2</integer>
